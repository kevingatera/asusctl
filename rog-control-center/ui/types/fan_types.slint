import { Node } from "../widgets/graph.slint";

export enum Profile {
    Balanced,
    Performance,
    Quiet,
    LowPower,
    Custom
}

export enum FanType {
    CPU,
    Middle,
    GPU,
}

export global FanPageData {
    in-out property <bool> available: false;
    in-out property <bool> loading: true;
    in-out property <bool> busy: false;
    in-out property <bool> has_error: false;
    in-out property <string> status_message: "";
    in-out property <string> active_profile: "";
    // The page uses this to start on the profile whose curve is actually
    // active. A string remains separate for the human-readable status label.
    in-out property <Profile> active_profile_kind: Profile.Balanced;

    in-out property <bool> cpu_fan_available: false;
    in-out property <bool> gpu_fan_available: false;
    in-out property <bool> mid_fan_available: false;
    in-out property <bool> balanced_available: false;
    in-out property <bool> performance_available: false;
    in-out property <bool> quiet_available: false;
    in-out property <bool> custom_available: false;
    in-out property <bool> custom_mode_available: false;
    in-out property <bool> quiet_is_low_power: false;

    in-out property <bool> balanced_cpu_enabled: false;
    in-out property <bool> balanced_gpu_enabled: false;
    in-out property <bool> balanced_mid_enabled: false;
    in-out property <bool> performance_cpu_enabled: false;
    in-out property <bool> performance_gpu_enabled: false;
    in-out property <bool> performance_mid_enabled: false;
    in-out property <bool> quiet_cpu_enabled: false;
    in-out property <bool> quiet_gpu_enabled: false;
    in-out property <bool> quiet_mid_enabled: false;
    in-out property <bool> custom_cpu_enabled: false;
    in-out property <bool> custom_gpu_enabled: false;
    in-out property <bool> custom_mid_enabled: false;

    in-out property <int> max_rpm: 0;

    callback set_fan_data(FanType, Profile, bool, [Node]);
    callback set_profile_default(Profile);
    callback reload_profile(Profile);

    in-out property <[Node]> balanced_cpu: [];
    in-out property <[Node]> balanced_mid: [];
    in-out property <[Node]> balanced_gpu: [];
    in-out property <[Node]> performance_cpu: [];
    in-out property <[Node]> performance_mid: [];
    in-out property <[Node]> performance_gpu: [];
    in-out property <[Node]> quiet_cpu: [];
    in-out property <[Node]> quiet_mid: [];
    in-out property <[Node]> quiet_gpu: [];
    in-out property <[Node]> custom_cpu: [];
    in-out property <[Node]> custom_mid: [];
    in-out property <[Node]> custom_gpu: [];

    function set_fan(profile: Profile, fan: FanType, data: [Node]) {
    }
}
