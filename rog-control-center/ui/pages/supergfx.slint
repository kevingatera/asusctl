import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme, Spacing, Typography, Radii } from "../globals.slint";
import { RogItem, SystemDropdown } from "../widgets/common.slint";

export global SupergfxPageData {
    in-out property <bool> available: false;
    in-out property <bool> busy: false;
    in-out property <[string]> modes: [];
    in-out property <int> selected_mode: 0;
    in-out property <string> current_mode: "";
    in-out property <string> power_state: "";
    in-out property <string> pending_mode: "";
    in-out property <string> pending_action: "";
    in-out property <string> vendor: "";
    in-out property <string> status_message: "";
    in-out property <bool> apply_enabled: false;
    callback request_set_mode(int);
    callback request_refresh();
}

export component PageSupergfx inherits Rectangle {
    background: Theme.background;

    ScrollView {
        VerticalLayout {
        padding: Spacing.lg;
        spacing: Spacing.lg;

        RogItem {
            min-height: 96px;
            max-height: 120px;
            HorizontalBox {
                padding-left: Spacing.lg;
                padding-right: Spacing.xl;
                spacing: Spacing.lg;
                alignment: LayoutAlignment.stretch;
                VerticalLayout {
                    spacing: Spacing.sm;
                    Text {
                        font-size: Typography.lg;
                        font-weight: Typography.weight-medium;
                        color: Theme.text-primary;
                        text: @tr("SupergfxHead" => "Graphics mode control");
                    }
                    Text {
                        wrap: TextWrap.word-wrap;
                        font-size: Typography.sm;
                        color: Theme.text-secondary;
                        text: @tr("SupergfxIntro" => "Switch between supported GPU modes and inspect the current committed graphics state.");
                    }
                }
            }
        }

        if !SupergfxPageData.available: RogItem {
            min-height: 96px;
            max-height: 144px;
            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.sm;
                Text {
                    wrap: TextWrap.word-wrap;
                    text: @tr("The supergfxctl daemon is not available. Ensure supergfxctl 5.2.0 or newer is installed and running.");
                    color: Theme.text-primary;
                    font-size: Typography.md;
                }
                Text {
                    visible: SupergfxPageData.status_message != "";
                    text: SupergfxPageData.status_message;
                    color: Theme.text-secondary;
                    wrap: TextWrap.word-wrap;
                    font-size: Typography.sm;
                }
            }
        }

        if SupergfxPageData.available: RogItem {
            min-height: 184px;
            max-height: 240px;
            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;
                Text {
                    font-size: Typography.md;
                    font-weight: Typography.weight-semibold;
                    color: Theme.text-primary;
                    text: @tr("Graphics Mode");
                }
                Text {
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-secondary;
                    font-size: Typography.sm;
                    text: @tr("Mode changes may require logout or reboot before they fully take effect. The status section below reflects the current committed mode.");
                }
                SystemDropdown {
                    text: @tr("Mode Selection" => "Preferred mode");
                    model <=> SupergfxPageData.modes;
                    current_index <=> SupergfxPageData.selected_mode;
                    current_value: SupergfxPageData.modes.length > SupergfxPageData.selected_mode ? SupergfxPageData.modes[SupergfxPageData.selected_mode] : "";
                    enabled: SupergfxPageData.apply_enabled && !SupergfxPageData.busy;
                }
                HorizontalBox {
                    spacing: Spacing.md;
                    Button {
                        text: @tr("Refresh");
                        enabled: !SupergfxPageData.busy;
                        clicked => { SupergfxPageData.request_refresh(); }
                    }
                    Button {
                        text: SupergfxPageData.busy ? @tr("Applying…") : @tr("Apply Mode");
                        enabled: SupergfxPageData.apply_enabled && !SupergfxPageData.busy;
                        clicked => { SupergfxPageData.request_set_mode(SupergfxPageData.selected_mode); }
                    }
                }
                Text {
                    visible: SupergfxPageData.status_message != "";
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-secondary;
                    text: SupergfxPageData.status_message;
                    font-size: Typography.sm;
                }
            }
        }

        if SupergfxPageData.available: RogItem {
            min-height: 164px;
            max-height: 240px;
            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.sm;
                Text {
                    font-size: Typography.md;
                    font-weight: Typography.weight-semibold;
                    color: Theme.text-primary;
                    text: @tr("Current Status");
                }
                Text { 
                    text: @tr("Current mode: {0}", SupergfxPageData.current_mode); 
                    color: Theme.text-primary;
                    font-size: Typography.md;
                }
                Text { 
                    text: @tr("Power state: {0}", SupergfxPageData.power_state); 
                    color: Theme.text-primary;
                    font-size: Typography.md;
                }
                Text {
                    text: @tr("Pending mode: {0}", SupergfxPageData.pending_mode);
                    visible: SupergfxPageData.pending_mode != "" && SupergfxPageData.pending_mode != SupergfxPageData.current_mode;
                    color: Theme.text-secondary;
                    font-size: Typography.md;
                }
                Text {
                    text: @tr("Pending action: {0}", SupergfxPageData.pending_action);
                    visible: SupergfxPageData.pending_action != "" && SupergfxPageData.pending_action != @tr("No action required");
                    color: Theme.text-secondary;
                    font-size: Typography.md;
                }
                Text {
                    text: @tr("dGPU vendor: {0}", SupergfxPageData.vendor);
                    visible: SupergfxPageData.vendor != "";
                    color: Theme.text-secondary;
                    font-size: Typography.md;
                }
            }
        }
        }
    }
}
