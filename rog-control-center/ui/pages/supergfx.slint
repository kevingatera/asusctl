import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme, Spacing, Typography, Radii } from "../globals.slint";
import { PageHeader, RogItem, SystemDropdown } from "../widgets/common.slint";

export global SupergfxPageData {
    in-out property <bool> available: false;
    in-out property <bool> busy: false;
    in-out property <[string]> modes: [];
    in-out property <int> selected_mode: 0;
    in-out property <string> current_mode: "";
    in-out property <string> power_state: "";
    in-out property <string> pending_mode: "";
    in-out property <string> pending_action: "";
    in-out property <string> vendor: "";
    in-out property <string> topology: "";
    in-out property <string> mode_note: "";
    in-out property <string> status_message: "";
    in-out property <bool> apply_enabled: false;
    callback request_set_mode(int);
    callback request_refresh();
}

component StatusRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <brush> value_color: Theme.text-primary;

    spacing: 2px;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Typography.xs;
        font-weight: Typography.weight-semibold;
    }

    Text {
        min-width: 0px;
        text: root.value;
        color: root.value_color;
        font-size: Typography.sm;
        wrap: TextWrap.word-wrap;
    }
}

export component PageSupergfx inherits Rectangle {
    background: Theme.background;
    property <int> status_row_count:
        2
        + (SupergfxPageData.topology != "" ? 1 : 0)
        + (SupergfxPageData.pending_mode != "" && SupergfxPageData.pending_mode != SupergfxPageData.current_mode ? 1 : 0)
        + (SupergfxPageData.pending_action != "" ? 1 : 0)
        + (SupergfxPageData.vendor != "" ? 1 : 0);
    property <length> status_card_min_height:
        180px
        + status_row_count * 48px
        + (SupergfxPageData.mode_note != "" ? 88px : 0px);
    property <length> mode_card_min_height:
        288px
        + (SupergfxPageData.status_message != "" ? 52px : 0px);

    ScrollView {
        VerticalLayout {
        padding: Spacing.lg;
        spacing: Spacing.lg;
        alignment: LayoutAlignment.start;

        PageHeader {
            badge: @tr("Graphics");
            title: @tr("Supergfx Control");
            subtitle: @tr("Choose battery saver, balanced hybrid graphics, or discrete-only performance mode and inspect both the supergfx state and the current hardware topology.");
            aside: @tr("Mode orchestration");
        }

        if !SupergfxPageData.available: RogItem {
            min-height: 172px;
            max-height: 220px;
            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.sm;
                alignment: center;
                Text {
                    font-size: Typography.lg;
                    font-weight: Typography.weight-semibold;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    text: @tr("supergfx_unavailable" => "Supergfx unavailable");
                }
                Text {
                    wrap: TextWrap.word-wrap;
                    horizontal-alignment: center;
                    text: @tr("The supergfxctl daemon is not available. Ensure supergfxctl 5.2.0 or newer is installed and running.");
                    color: Theme.text-secondary;
                    font-size: Typography.sm;
                }
                Text {
                    visible: SupergfxPageData.status_message != "";
                    wrap: TextWrap.word-wrap;
                    horizontal-alignment: center;
                    text: SupergfxPageData.status_message;
                    color: Theme.text-secondary;
                    font-size: Typography.sm;
                }
            }
        }

        if SupergfxPageData.available: RogItem {
            min-height: mode_card_min_height;
            max-height: mode_card_min_height + 88px;
            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;
                Text {
                    font-size: Typography.md;
                    font-weight: Typography.weight-semibold;
                    color: Theme.text-primary;
                    text: @tr("Graphics Mode");
                }
                Text {
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-secondary;
                    font-size: Typography.sm;
                    text: @tr("Integrated keeps only the iGPU active for battery life. Hybrid keeps the iGPU primary and wakes the dGPU on demand. Ultimate / MUX dGPU makes the dGPU primary for maximum performance. Mode changes may require logout or reboot before they fully take effect.");
                }
                SystemDropdown {
                    min-height: 72px;
                    max-height: 96px;
                    text: @tr("Mode Selection" => "Mode");
                    model <=> SupergfxPageData.modes;
                    current_index <=> SupergfxPageData.selected_mode;
                    current_value: SupergfxPageData.modes.length > SupergfxPageData.selected_mode ? SupergfxPageData.modes[SupergfxPageData.selected_mode] : "";
                    enabled: SupergfxPageData.apply_enabled && !SupergfxPageData.busy;
                }
                HorizontalBox {
                    spacing: Spacing.md;
                    Button {
                        text: @tr("Refresh");
                        enabled: !SupergfxPageData.busy;
                        clicked => { SupergfxPageData.request_refresh(); }
                    }
                    Button {
                        text: SupergfxPageData.busy ? @tr("Applying…") : @tr("Apply Mode");
                        enabled: SupergfxPageData.apply_enabled && !SupergfxPageData.busy;
                        clicked => { SupergfxPageData.request_set_mode(SupergfxPageData.selected_mode); }
                    }
                }
                Text {
                    visible: SupergfxPageData.status_message != "";
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-secondary;
                    text: SupergfxPageData.status_message;
                    font-size: Typography.sm;
                }
            }
        }

        if SupergfxPageData.available: RogItem {
            min-height: 186px;
            max-height: 260px;
            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.xs;
                Text {
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-primary;
                    font-size: Typography.sm;
                    text: @tr("Integrated: Battery saver. Runs only on the built-in integrated GPU and powers the discrete GPU down.");
                }
                Text {
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-primary;
                    font-size: Typography.sm;
                    text: @tr("Hybrid: Balanced everyday mode. The integrated GPU drives the desktop while apps can wake the discrete GPU when extra graphics power is needed.");
                }
                Text {
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-primary;
                    font-size: Typography.sm;
                    text: @tr("Ultimate / MUX dGPU: Highest performance. Switches the laptop's hardware MUX so the discrete GPU becomes the primary display GPU. This usually needs a reboot and uses more power.");
                }
            }
        }

        if SupergfxPageData.available: RogItem {
            min-height: status_card_min_height;
            max-height: status_card_min_height + 140px;
            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.sm;
                Text {
                    font-size: Typography.md;
                    font-weight: Typography.weight-semibold;
                    color: Theme.text-primary;
                    text: @tr("Current Status");
                }
                StatusRow {
                    label: @tr("Current mode");
                    value: SupergfxPageData.current_mode;
                }
                if SupergfxPageData.topology != "": StatusRow {
                    label: @tr("Hardware topology");
                    value: SupergfxPageData.topology;
                }
                StatusRow {
                    label: @tr("Power state");
                    value: SupergfxPageData.power_state;
                }
                if SupergfxPageData.pending_mode != "" && SupergfxPageData.pending_mode != SupergfxPageData.current_mode: StatusRow {
                    label: @tr("Pending mode");
                    value: SupergfxPageData.pending_mode;
                    value_color: Theme.text-secondary;
                }
                if SupergfxPageData.pending_action != "": StatusRow {
                    label: @tr("Pending action");
                    value: SupergfxPageData.pending_action;
                    value_color: Theme.text-secondary;
                }
                if SupergfxPageData.vendor != "": StatusRow {
                    label: @tr("dGPU vendor");
                    value: SupergfxPageData.vendor;
                    value_color: Theme.text-secondary;
                }
                Text {
                    visible: SupergfxPageData.mode_note != "";
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-secondary;
                    font-size: Typography.sm;
                    text: SupergfxPageData.mode_note;
                }
            }
        }
        }
    }
}
