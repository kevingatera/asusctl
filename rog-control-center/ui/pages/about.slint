import { AboutSlint, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, Spacing, Typography } from "../globals.slint";

export component PageAbout inherits VerticalLayout {
    padding: Spacing.lg;
    spacing: Spacing.lg;
    
    VerticalBox {
        spacing: Spacing.xl;
        alignment: center;
        
        Text {
            vertical-alignment: TextVerticalAlignment.center;
            horizontal-alignment: TextHorizontalAlignment.center;
            text: "A UI for asusctl made with slint";
            font-size: Typography.xxl;
            font-weight: Typography.weight-bold;
            color: Theme.primary;
        }

        HorizontalBox {
            alignment: LayoutAlignment.center;
            VerticalBox {
                alignment: LayoutAlignment.center;
                spacing: Spacing.md;

                Text {
                    wrap: TextWrap.word-wrap;
                    text: "You will require a kernel built with my work from here: https://github.com/flukejones/linux";
                    font-size: Typography.md;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    vertical-alignment: TextVerticalAlignment.center;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    text: "Todo:";
                    font-size: Typography.xl;
                    font-weight: Typography.weight-semibold;
                    color: Theme.text-primary;
                }
                
                VerticalBox {
                    spacing: Spacing.sm;
                    Text {
                        text: "- [x] Theme the widgets";
                        color: Theme.success;
                        font-size: Typography.md;
                    }
    
                    Text {
                        text: "- [x] Add a cpu/gpu temp/fan speed info bar";
                        color: Theme.success;
                        font-size: Typography.md;
                    }
    
                    Text {
                        text: "- [x] Include fan speeds, temps in a bottom bar";
                        color: Theme.success;
                        font-size: Typography.md;
                    }
    
                    Text {
                        text: "- [x] Slash control";
                        color: Theme.success;
                        font-size: Typography.md;
                    }
    
                    Text {
                        text: "- [x] Supergfx control";
                        color: Theme.success;
                        font-size: Typography.md;
                    }
    
                    Text {
                        text: "- [ ] Screenpad controls";
                        color: Theme.text-secondary;
                        font-size: Typography.md;
                    }
    
                    Text {
                        text: "- [ ] ROG Ally specific settings";
                        color: Theme.text-secondary;
                        font-size: Typography.md;
                    }
                }
            }
        }

        Text {
            vertical-alignment: TextVerticalAlignment.center;
            horizontal-alignment: TextHorizontalAlignment.center;
            text: "Work in progress";
            font-size: Typography.xl;
            color: Theme.warning;
        }
    }
}
