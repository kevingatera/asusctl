import { ScrollView } from "std-widgets.slint";
import { Theme, Spacing, Typography } from "../globals.slint";
import { PageHeader, PageLayout, RogItem } from "../widgets/common.slint";

component AboutCard inherits RogItem {
    in property <string> title;
    in property <string> body;

    min-width: 0px;
    min-height: 72px;
    max-height: 320px;

    VerticalLayout {
        padding-top: Spacing.md;
        padding-bottom: Spacing.md;
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.xs;
        alignment: LayoutAlignment.start;

        Text {
            text: root.title;
            font-size: Typography.sm;
            font-weight: Typography.weight-semibold;
            color: Theme.text-primary;
        }

        Text {
            min-width: 0px;
            text: root.body;
            font-size: Typography.xs;
            color: Theme.text-secondary;
            wrap: TextWrap.word-wrap;
        }
    }
}

export component PageAbout inherits Rectangle {
    clip: true;

    ScrollView {
        PageLayout {

            PageHeader {
                badge: @tr("About");
                title: @tr("ROG Control Center");
                subtitle: @tr("ASUS Linux controls for the hardware on this machine.");
                aside: @tr("asusctl GUI");
            }

            AboutCard {
                title: @tr("What it is");
                body: @tr("ROG Control Center is the graphical front end for asusctl and related services. It keeps the UI close to the machine's actual capabilities instead of showing controls that do not apply.");
            }

            AboutCard {
                title: @tr("How the modes relate");
                body: @tr("A performance mode is the top-level choice. Its CPU preference, power limits, and fan settings are stored together. A curve override applies to one fan within that mode. AC and battery rules choose which mode is active.");
            }

            AboutCard {
                title: @tr("What it needs");
                body: @tr("Kernel 6.19 or newer.\nasusd for platform controls.\nsupergfxctl for graphics routing.");
            }

            AboutCard {
                title: @tr("Why some pages are hidden");
                body: @tr("Pages only appear when the matching hardware or service is present. That keeps the interface honest: if a feature is not supported on this laptop, it does not get a dead control.");
            }

            AboutCard {
                title: @tr("Project links");
                body: "Source code: https://gitlab.com/asus-linux/asusctl\nWebsite: https://asus-linux.org/\nLicense: MPL-2.0";
            }
        }
    }
}
