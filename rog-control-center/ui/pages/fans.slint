import { Palette, TabWidget, Button, CheckBox, ScrollView } from "std-widgets.slint";
import { Graph, Node } from "../widgets/graph.slint";
import { PageHeader, SystemToggle } from "../widgets/common.slint";
import { Profile, FanType, FanPageData } from "../types/fan_types.slint";
import { Spacing, Typography, Theme } from "../globals.slint";

component FanTab inherits Rectangle {
    in-out property <bool> enabled: false;
    in property <bool> profile_available: true;
    in-out property <bool> tab_enabled: true;
    in property <Profile> profile;
    in property <FanType> fan_type;
    callback apply();
    callback cancel();
    callback default();
    callback toggled();
    in property <string> title;
    in-out property <[Node]> nodes;
    property <bool> active: root.profile_available && root.tab_enabled;

    VerticalLayout {
        padding: Spacing.lg;
        spacing: Spacing.lg;

        HorizontalLayout {
            vertical-stretch: 1;
            if root.active: Graph {
                nodes <=> root.nodes;
                max-rpm: FanPageData.max_rpm;
            }
            if !root.active: Rectangle {
                VerticalLayout {
                    alignment: center;
                    Text {
                        font-size: Typography.xl;
                        font-weight: Typography.weight-medium;
                        color: Theme.text-secondary;
                        text: root.profile_available
                            ? @tr("This fan is not avilable on this machine")
                            : @tr("This profile is not available on this machine");
                        horizontal-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            spacing: Spacing.md;

            CheckBox {
                text: @tr("Enabled");
                checked <=> root.enabled;
                enabled <=> root.active;
                toggled => {
                    root.toggled();
                }
            }

            Button {
                text: @tr("Apply");
                enabled <=> root.active;
                clicked => {
                    root.apply();
                }
            }

            Button {
                text: @tr("Cancel");
                enabled <=> root.active;
                clicked => {
                    root.cancel()
                }
            }

            Button {
                text: @tr("Factory Default (all fans)");
                enabled <=> root.active;
                clicked => {
                    root.default();
                }
            }
        }
    }
}

export component PageFans inherits VerticalLayout {
    padding: Spacing.lg;
    spacing: Spacing.lg;

    PageHeader {
        badge: @tr("Cooling");
        title: @tr("Fan Curves");
        subtitle: @tr("Tune per-profile fan behavior, preview available curves, and restore factory defaults when needed.");
        aside: @tr("Thermal profiles");
    }

    ScrollView {
        TabWidget {
            Tab {
                title: @tr("Balanced");
                TabWidget {
                    Tab {
                        title: @tr("CPU");
                        FanTab {
                            profile_available <=> FanPageData.balanced_available;
                            tab_enabled <=> FanPageData.cpu_fan_available;
                            enabled <=> FanPageData.balanced_cpu_enabled;
                            nodes <=> FanPageData.balanced_cpu;
                            apply => {
                                FanPageData.set_fan_data(FanType.CPU, Profile.Balanced, self.enabled, FanPageData.balanced_cpu);
                            }
                            cancel => {
                                FanPageData.reload_profile(Profile.Balanced);
                            }
                            toggled => {
                                FanPageData.set_fan_data(FanType.CPU, Profile.Balanced, self.enabled, FanPageData.balanced_cpu);
                            }
                            default => {
                                FanPageData.set_profile_default(Profile.Balanced);
                            }
                        }
                    }

                    Tab {
                        title: @tr("Mid");
                        FanTab {
                            profile_available <=> FanPageData.balanced_available;
                            tab_enabled <=> FanPageData.mid_fan_available;
                            enabled <=> FanPageData.balanced_mid_enabled;
                            nodes <=> FanPageData.balanced_mid;
                            apply => {
                                FanPageData.set_fan_data(FanType.Middle, Profile.Balanced, self.enabled, FanPageData.balanced_mid);
                            }
                            cancel => {
                                FanPageData.reload_profile(Profile.Balanced);
                            }
                            toggled => {
                                FanPageData.set_fan_data(FanType.Middle, Profile.Balanced, self.enabled, FanPageData.balanced_mid);
                            }
                            default => {
                                FanPageData.set_profile_default(Profile.Balanced);
                            }
