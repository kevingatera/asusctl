import { ScrollView } from "std-widgets.slint";
import { Graph, Node } from "../widgets/graph.slint";
import { ActionButton, PageHeader, PageLayout, PrimarySwitch, RogItem } from "../widgets/common.slint";
import { Profile, FanType, FanPageData } from "../types/fan_types.slint";
import { Spacing, Typography, Theme, Radii, Animations } from "../globals.slint";

component SelectorChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    // Shown dimmed when false, but still clickable so the page can
    // display its "not available on this machine" message.
    in property <bool> available: true;
    callback clicked();

    height: 30px;
    border-radius: Radii.sm;
    border-width: 1px;
    border-color: root.selected ? Theme.primary : (touch.has-hover ? Theme.border-focus : Theme.border);
    background: root.selected
        ? (touch.has-hover ? Theme.primary.with-alpha(0.22) : Theme.primary.with-alpha(0.14))
        : (touch.has-hover ? Theme.surface-hover : transparent);
    opacity: root.available ? 1.0 : 0.45;

    animate background, border-color {
        duration: Animations.fast;
        easing: Animations.ease;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            font-size: Typography.sm;
            font-weight: root.selected ? Typography.weight-semibold : Typography.weight-medium;
            color: root.selected ? Theme.text-primary : (root.available ? Theme.text-secondary : Theme.text-tertiary);
            vertical-alignment: TextVerticalAlignment.center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component FanTab inherits Rectangle {
    in-out property <bool> enabled: false;
    in property <bool> profile_available: true;
    in-out property <bool> tab_enabled: true;
    in property <Profile> profile;
    in property <FanType> fan_type;
    callback apply();
    callback cancel();
    callback default();
    in property <string> title;
    in-out property <[Node]> nodes;
    property <bool> interactive: FanPageData.available && !FanPageData.loading && !FanPageData.has_error;
    property <bool> active: root.interactive && root.profile_available && root.tab_enabled;

    VerticalLayout {
        spacing: Spacing.md;

        HorizontalLayout {
            vertical-stretch: 1;
            if root.active: VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: Spacing.sm;

                HorizontalLayout {
                    height: 28px;
                    Text {
                        text: @tr("Temperature curve");
                        color: Theme.text-primary;
                        font-size: Typography.md;
                        font-weight: Typography.weight-semibold;
                    }
                    Text {
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        text: root.enabled
                            ? @tr("Override active · drag points to adjust fan speed")
                            : @tr("Saved curve · firmware default is active");
                        color: Theme.text-secondary;
                        font-size: Typography.xs;
                    }
                }

                Graph {
                    vertical-stretch: 1;
                    nodes <=> root.nodes;
                    max-rpm: FanPageData.max_rpm;
                }
            }
            if !root.active: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Radii.md;
                VerticalLayout {
                    padding: Spacing.lg;
                    alignment: center;
                    Text {
                        font-size: Typography.lg;
                        font-weight: Typography.weight-semibold;
                        color: Theme.text-secondary;
                        text: FanPageData.loading
                            ? @tr("Loading fan controls…")
                            : FanPageData.has_error
                            ? (FanPageData.status_message != ""
                                ? FanPageData.status_message
                                : @tr("Fan controls are unavailable right now"))
                            : root.profile_available
                            ? @tr("This fan is unavailable on this machine")
                            : @tr("This profile is unavailable on this machine");
                        horizontal-alignment: center;
                        wrap: TextWrap.word-wrap;
                    }
                }
            }
        }

        Rectangle {
            min-height: 72px;
            max-height: 84px;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Radii.md;

            HorizontalLayout {
                padding: Spacing.md;
                spacing: Spacing.md;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;

                    HorizontalLayout {
                        Text {
                            text: root.enabled ? @tr("Curve override active") : @tr("Firmware curve");
                            color: Theme.text-primary;
                            font-size: Typography.md;
                            font-weight: Typography.weight-semibold;
                        }
                    }

                    Text {
                        wrap: TextWrap.word-wrap;
                        color: Theme.text-secondary;
                        font-size: Typography.xs;
                        text: @tr("Use this curve instead of the firmware default for this fan in this mode.");
                    }
                }

                Text {
                    text: root.enabled ? @tr("Override active") : @tr("Firmware default");
                    color: root.enabled ? Theme.primary : Theme.text-secondary;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }

                PrimarySwitch {
                    checked <=> root.enabled;
                    enabled: root.active && !FanPageData.busy;
                }

                ActionButton {
                    text: FanPageData.busy ? @tr("Working…") : @tr("Apply");
                    enabled: root.active && !FanPageData.busy;
                    primary: true;
                    clicked => {
                        root.apply();
                    }
                }

                ActionButton {
                    text: @tr("Cancel");
                    enabled: root.active && !FanPageData.busy;
                    clicked => {
                        root.cancel()
                    }
                }

                ActionButton {
                    text: @tr("Reset");
                    enabled: root.active && !FanPageData.busy;
                    clicked => {
                        root.default();
                    }
                }
            }
        }
    }
}

export component PageFans inherits PageLayout {

    // Start on the live profile instead of silently editing a different
    // saved profile (for example Balanced while the machine is on Low Power).
    // Clicking a chip intentionally replaces this binding and lets the user
    // edit another profile for later use.
    property <Profile> selected_profile: FanPageData.active_profile_kind;
    property <FanType> selected_fan: FanType.CPU;
    property <string> selected_profile_name:
        selected_profile == Profile.Balanced ? @tr("Balanced") :
        selected_profile == Profile.Performance ? @tr("Performance") :
        selected_profile == Profile.Quiet
            ? (FanPageData.quiet_is_low_power ? @tr("Low Power") : @tr("Quiet")) :
        selected_profile == Profile.LowPower ? @tr("Low Power") :
        @tr("Custom");

    PageHeader {
        badge: @tr("Cooling");
        title: @tr("Fan Curves");
        subtitle: @tr("Edit the cooling curve used by each performance mode.");
        aside: "";
    }

    HorizontalLayout {
        height: 28px;
        spacing: Spacing.sm;

        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: Radii.full;
            background: FanPageData.has_error ? Theme.error : Theme.primary;
        }

        Text {
            vertical-alignment: center;
            color: Theme.text-secondary;
            font-size: Typography.sm;
            text: FanPageData.active_profile != ""
                ? @tr("Active now: {0}", FanPageData.active_profile)
                : @tr("Active mode");
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            color: Theme.text-tertiary;
            font-size: Typography.xs;
            text: @tr("Edits are saved per mode.");
        }

        Text {
            visible: FanPageData.status_message != "";
            vertical-alignment: center;
            color: FanPageData.has_error ? Theme.error : Theme.text-secondary;
            font-size: Typography.xs;
            text: FanPageData.status_message;
        }
    }

    if FanPageData.loading || !FanPageData.available: RogItem {
        min-height: 172px;
        max-height: 220px;

        VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.sm;
            alignment: center;

            Text {
                font-size: Typography.lg;
                font-weight: Typography.weight-semibold;
                color: Theme.text-primary;
                horizontal-alignment: center;
                text: FanPageData.loading ? @tr("Loading fan curves") : @tr("Fan curves unavailable");
            }

            Text {
                wrap: TextWrap.word-wrap;
                color: FanPageData.has_error ? Theme.error : Theme.text-secondary;
                font-size: Typography.sm;
                horizontal-alignment: center;
                text: FanPageData.loading
                    ? @tr("Reading the available fan controls…")
                    : FanPageData.status_message != ""
                    ? FanPageData.status_message
                    : @tr("This machine did not report editable fan curves.");
            }
        }
    }

    if FanPageData.available && !FanPageData.loading: HorizontalLayout {
        spacing: Spacing.md;

        Rectangle {
            horizontal-stretch: 1;
            min-width: 390px;
            height: 68px;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Radii.md;

            VerticalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                HorizontalLayout {
                    Text {
                        text: @tr("Performance mode");
                        font-size: Typography.xs;
                        font-weight: Typography.weight-semibold;
                        color: Theme.text-secondary;
                    }
                    Text {
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        text: @tr("Editing: {0}", root.selected_profile_name);
                        font-size: Typography.xs;
                        color: Theme.text-tertiary;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;

                    SelectorChip {
                        label: @tr("Balanced");
                        selected: root.selected_profile == Profile.Balanced;
                        available: FanPageData.balanced_available;
                        clicked => {
                            root.selected_profile = Profile.Balanced;
                        }
                    }

                    SelectorChip {
                        label: @tr("Performance");
                        selected: root.selected_profile == Profile.Performance;
                        available: FanPageData.performance_available;
                        clicked => {
                            root.selected_profile = Profile.Performance;
                        }
                    }

                    SelectorChip {
                        label: FanPageData.quiet_is_low_power ? @tr("Low Power") : @tr("Quiet");
                        selected: root.selected_profile == Profile.Quiet;
                        available: FanPageData.quiet_available;
                        clicked => {
                            root.selected_profile = Profile.Quiet;
                        }
                    }

                    if FanPageData.custom_mode_available: SelectorChip {
                        label: @tr("Custom");
                        selected: root.selected_profile == Profile.Custom;
                        available: FanPageData.custom_available;
                        clicked => {
                            root.selected_profile = Profile.Custom;
                        }
                    }
                }
            }
        }

        Rectangle {
            min-width: 300px;
            height: 68px;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Radii.md;

            VerticalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                Text {
                    text: @tr("Fan");
                    font-size: Typography.xs;
                    font-weight: Typography.weight-semibold;
                    color: Theme.text-secondary;
                }

                HorizontalLayout {
                    spacing: 4px;

                    SelectorChip {
                        label: @tr("CPU");
                        selected: root.selected_fan == FanType.CPU;
                        available: FanPageData.cpu_fan_available;
                        clicked => {
                            root.selected_fan = FanType.CPU;
                        }
                    }

                    SelectorChip {
                        label: @tr("Mid");
                        selected: root.selected_fan == FanType.Middle;
                        available: FanPageData.mid_fan_available;
                        clicked => {
                            root.selected_fan = FanType.Middle;
                        }
                    }

                    SelectorChip {
                        label: @tr("GPU");
                        selected: root.selected_fan == FanType.GPU;
                        available: FanPageData.gpu_fan_available;
                        clicked => {
                            root.selected_fan = FanType.GPU;
                        }
                    }
                }
            }
        }
    }

    if FanPageData.available && !FanPageData.loading: ScrollView {
        if root.selected_profile == Profile.Balanced && root.selected_fan == FanType.CPU: FanTab {
            profile_available <=> FanPageData.balanced_available;
            tab_enabled <=> FanPageData.cpu_fan_available;
            enabled <=> FanPageData.balanced_cpu_enabled;
            nodes <=> FanPageData.balanced_cpu;
            apply => {
                FanPageData.set_fan_data(FanType.CPU, Profile.Balanced, self.enabled, FanPageData.balanced_cpu);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Balanced);
            }
            default => {
                FanPageData.set_profile_default(Profile.Balanced);
            }
        }

        if root.selected_profile == Profile.Balanced && root.selected_fan == FanType.Middle: FanTab {
            profile_available <=> FanPageData.balanced_available;
            tab_enabled <=> FanPageData.mid_fan_available;
            enabled <=> FanPageData.balanced_mid_enabled;
            nodes <=> FanPageData.balanced_mid;
            apply => {
                FanPageData.set_fan_data(FanType.Middle, Profile.Balanced, self.enabled, FanPageData.balanced_mid);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Balanced);
            }
            default => {
                FanPageData.set_profile_default(Profile.Balanced);
            }
        }

        if root.selected_profile == Profile.Balanced && root.selected_fan == FanType.GPU: FanTab {
            profile_available <=> FanPageData.balanced_available;
            tab_enabled <=> FanPageData.gpu_fan_available;
            enabled <=> FanPageData.balanced_gpu_enabled;
            nodes <=> FanPageData.balanced_gpu;
            apply => {
                FanPageData.set_fan_data(FanType.GPU, Profile.Balanced, self.enabled, FanPageData.balanced_gpu);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Balanced);
            }
            default => {
                FanPageData.set_profile_default(Profile.Balanced);
            }
        }

        if root.selected_profile == Profile.Performance && root.selected_fan == FanType.CPU: FanTab {
            profile_available <=> FanPageData.performance_available;
            tab_enabled <=> FanPageData.cpu_fan_available;
            enabled <=> FanPageData.performance_cpu_enabled;
            nodes <=> FanPageData.performance_cpu;
            apply => {
                FanPageData.set_fan_data(FanType.CPU, Profile.Performance, self.enabled, FanPageData.performance_cpu);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Performance);
            }
            default => {
                FanPageData.set_profile_default(Profile.Performance);
            }
        }

        if root.selected_profile == Profile.Performance && root.selected_fan == FanType.Middle: FanTab {
            profile_available <=> FanPageData.performance_available;
            tab_enabled <=> FanPageData.mid_fan_available;
            enabled <=> FanPageData.performance_mid_enabled;
            nodes <=> FanPageData.performance_mid;
            apply => {
                FanPageData.set_fan_data(FanType.Middle, Profile.Performance, self.enabled, FanPageData.performance_mid);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Performance);
            }
            default => {
                FanPageData.set_profile_default(Profile.Performance);
            }
        }

        if root.selected_profile == Profile.Performance && root.selected_fan == FanType.GPU: FanTab {
            profile_available <=> FanPageData.performance_available;
            tab_enabled <=> FanPageData.gpu_fan_available;
            enabled <=> FanPageData.performance_gpu_enabled;
            nodes <=> FanPageData.performance_gpu;
            apply => {
                FanPageData.set_fan_data(FanType.GPU, Profile.Performance, self.enabled, FanPageData.performance_gpu);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Performance);
            }
            default => {
                FanPageData.set_profile_default(Profile.Performance);
            }
        }

        if root.selected_profile == Profile.Quiet && root.selected_fan == FanType.CPU: FanTab {
            profile_available <=> FanPageData.quiet_available;
            tab_enabled <=> FanPageData.cpu_fan_available;
            enabled <=> FanPageData.quiet_cpu_enabled;
            nodes <=> FanPageData.quiet_cpu;
            apply => {
                FanPageData.set_fan_data(FanType.CPU, Profile.Quiet, self.enabled, FanPageData.quiet_cpu);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Quiet);
            }
            default => {
                FanPageData.set_profile_default(Profile.Quiet);
            }
        }

        if root.selected_profile == Profile.Quiet && root.selected_fan == FanType.Middle: FanTab {
            profile_available <=> FanPageData.quiet_available;
            tab_enabled <=> FanPageData.mid_fan_available;
            enabled <=> FanPageData.quiet_mid_enabled;
            nodes <=> FanPageData.quiet_mid;
            apply => {
                FanPageData.set_fan_data(FanType.Middle, Profile.Quiet, self.enabled, FanPageData.quiet_mid);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Quiet);
            }
            default => {
                FanPageData.set_profile_default(Profile.Quiet);
            }
        }

        if root.selected_profile == Profile.Quiet && root.selected_fan == FanType.GPU: FanTab {
            profile_available <=> FanPageData.quiet_available;
            tab_enabled <=> FanPageData.gpu_fan_available;
            enabled <=> FanPageData.quiet_gpu_enabled;
            nodes <=> FanPageData.quiet_gpu;
            apply => {
                FanPageData.set_fan_data(FanType.GPU, Profile.Quiet, self.enabled, FanPageData.quiet_gpu);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Quiet);
            }
            default => {
                FanPageData.set_profile_default(Profile.Quiet);
            }
        }

        if root.selected_profile == Profile.Custom && root.selected_fan == FanType.CPU: FanTab {
            profile_available <=> FanPageData.custom_available;
            tab_enabled <=> FanPageData.cpu_fan_available;
            enabled <=> FanPageData.custom_cpu_enabled;
            nodes <=> FanPageData.custom_cpu;
            apply => {
                FanPageData.set_fan_data(FanType.CPU, Profile.Custom, self.enabled, FanPageData.custom_cpu);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Custom);
            }
            default => {
                FanPageData.set_profile_default(Profile.Custom);
            }
        }

        if root.selected_profile == Profile.Custom && root.selected_fan == FanType.Middle: FanTab {
            profile_available <=> FanPageData.custom_available;
            tab_enabled <=> FanPageData.mid_fan_available;
            enabled <=> FanPageData.custom_mid_enabled;
            nodes <=> FanPageData.custom_mid;
            apply => {
                FanPageData.set_fan_data(FanType.Middle, Profile.Custom, self.enabled, FanPageData.custom_mid);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Custom);
            }
            default => {
                FanPageData.set_profile_default(Profile.Custom);
            }
        }

        if root.selected_profile == Profile.Custom && root.selected_fan == FanType.GPU: FanTab {
            profile_available <=> FanPageData.custom_available;
            tab_enabled <=> FanPageData.gpu_fan_available;
            enabled <=> FanPageData.custom_gpu_enabled;
            nodes <=> FanPageData.custom_gpu;
            apply => {
                FanPageData.set_fan_data(FanType.GPU, Profile.Custom, self.enabled, FanPageData.custom_gpu);
            }
            cancel => {
                FanPageData.reload_profile(Profile.Custom);
            }
            default => {
                FanPageData.set_profile_default(Profile.Custom);
            }
        }
    }
}
