import { Theme, Typography, Spacing, Radii } from "../globals.slint";

component HexInput inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    callback accepted(string);

    min-height: 36px;
    max-height: 40px;
    border-radius: Radii.md;
    border-width: 1px;
    border-color: enabled ? Theme.border : Theme.surface-active;
    background: enabled ? Theme.surface-active : Theme.surface;

    input := TextInput {
        x: Spacing.sm;
        y: 0px;
        width: parent.width - 2 * Spacing.sm;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        color: root.enabled ? Theme.text-primary : Theme.text-secondary;
        font-size: Typography.sm;
        vertical-alignment: center;
        single-line: true;
        accepted => {
            root.accepted(self.text);
        }
    }
}

component ColourRamp inherits Rectangle {
    in-out property <float> value;
    in property <float> maximum: 100;
    in property <brush> ramp;
    in property <bool> enabled: true;
    callback changed(float);
    callback released(float);

    min-width: 0px;
    horizontal-stretch: 1;
    height: 28px;
    border-width: 1px;
    border-radius: Radii.md;
    border-color: enabled ? Theme.border : Theme.surface-active;
    background: enabled ? root.ramp : Theme.surface-active;
    clip: true;

    property <float> normalized: maximum > 0 ? value / maximum : 0;

    thumb := Rectangle {
        width: 16px;
        height: 16px;
        x: (root.width - self.width) * root.normalized;
        y: (root.height - self.height) / 2;
        border-radius: Radii.full;
        background: enabled ? Theme.surface : Theme.text-secondary;
        border-width: 2px;
        border-color: enabled ? Theme.primary : Theme.border;
    }

    TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.up) {
                root.released(root.value);
                return;
            }
            root.set-value(self.mouse-x);
        }
        moved => {
            if (self.pressed) {
                root.set-value(self.mouse-x);
            }
        }
    }

    public function set-value(x: length) {
        let usable = root.width - thumb.width;
        if (usable <= 0px || root.maximum <= 0) {
            return;
        }
        root.value = max(0, min(root.maximum, x / usable * root.maximum));
        root.changed(root.value);
    }
}

export component ColourSlider inherits VerticalLayout {
    min-width: 0px;
    horizontal-stretch: 1;
    spacing: Spacing.md;
    in-out property <bool> enabled;
    property <string> hex: "#FF0000";
    in-out property <float> c1value <=> c1.value;
    in-out property <float> c2value <=> c2.value;
    in-out property <float> c3value <=> c3.value;
    property <color> base_colour: Colors.red;
    in-out property <color> final_colour: Colors.red;
    in-out property <brush> colourbox: final_colour;
    callback hex_to_colour(string) -> color;
    // required
    callback set_hex_from_colour(color) -> string;
    callback released();

    property <[color]> base_colours: [
        hsv(0, 1, 1),
        hsv(10, 1, 1),
        hsv(20, 1, 1),
        hsv(30, 1, 1),
        hsv(40, 1, 1),
        hsv(50, 1, 1),
        hsv(60, 1, 1),
        hsv(70, 1, 1),
        hsv(80, 1, 1),
        hsv(90, 1, 1),
        hsv(100, 1, 1),
        hsv(110, 1, 1),
        hsv(120, 1, 1),
        hsv(130, 1, 1),
        hsv(140, 1, 1),
        hsv(150, 1, 1),
        hsv(160, 1, 1),
        hsv(170, 1, 1),
        hsv(180, 1, 1),
        hsv(190, 1, 1),
        hsv(200, 1, 1),
        hsv(210, 1, 1),
        hsv(220, 1, 1),
        hsv(230, 1, 1),
        hsv(240, 1, 1),
        hsv(250, 1, 1),
        hsv(260, 1, 1),
        hsv(270, 1, 1),
        hsv(280, 1, 1),
        hsv(290, 1, 1),
        hsv(300, 1, 1),
        hsv(310, 1, 1),
        hsv(320, 1, 1),
        hsv(330, 1, 1),
        hsv(340, 1, 1),
        hsv(350, 1, 1),
        hsv(360, 1, 1),
    ];
    property <[color]> base_saturation: [
        hsv(base_colour.to-hsv().hue, 1, 1),
        hsv(base_colour.to-hsv().hue, 0.9, 1),
        hsv(base_colour.to-hsv().hue, 0.8, 1),
        hsv(base_colour.to-hsv().hue, 0.7, 1),
        hsv(base_colour.to-hsv().hue, 0.6, 1),
        hsv(base_colour.to-hsv().hue, 0.5, 1),
        hsv(base_colour.to-hsv().hue, 0.4, 1),
        hsv(base_colour.to-hsv().hue, 0.3, 1),
        hsv(base_colour.to-hsv().hue, 0.2, 1),
        hsv(base_colour.to-hsv().hue, 0.1, 1),
        hsv(base_colour.to-hsv().hue, 0, 1),
    ];
    property <[color]> base_value: [
        hsv(base_colour.to-hsv().hue, 1, 1),
        hsv(base_colour.to-hsv().hue, 1, 0.9),
        hsv(base_colour.to-hsv().hue, 1, 0.8),
        hsv(base_colour.to-hsv().hue, 1, 0.7),
        hsv(base_colour.to-hsv().hue, 1, 0.6),
        hsv(base_colour.to-hsv().hue, 1, 0.5),
        hsv(base_colour.to-hsv().hue, 1, 0.4),
        hsv(base_colour.to-hsv().hue, 1, 0.3),
        hsv(base_colour.to-hsv().hue, 1, 0.2),
        hsv(base_colour.to-hsv().hue, 1, 0.1),
        hsv(base_colour.to-hsv().hue, 1, 0),
    ];

    function set_base_colour() {
        root.base_colour = hsv(c1.value / base_colours.length * 360, 1, 1);
        root.final_colour = hsv(base_colour.to-hsv().hue, ((base_saturation.length - c2.value) / base_saturation.length), ((base_value.length - c3.value) / base_value.length));
        root.colourbox = root.final_colour;
    }

    callback external_colour_change();

    external_colour_change => {
        if (root.final_colour.to-hsv().hue < 0) {
            c1.value = root.base_colours.length * (root.final_colour.to-hsv().hue + 360) / 360;
        } else {
            c1.value = root.base_colours.length * root.final_colour.to-hsv().hue / 360;
        }
        // c1.value = root.base_colours.length * 360 / root.final_colour.to-hsv().hue;
        c2.value = root.base_saturation.length - root.base_saturation.length * root.final_colour.to-hsv().saturation;
        c3.value = root.base_value.length - root.base_value.length * root.final_colour.to-hsv().value;
        root.set_base_colour();
        hex = set_hex_from_colour(final_colour);
    }
    VerticalLayout {
        spacing: Spacing.xs;
        Text {
            text: @tr("Hue");
            font-size: Typography.xs;
            color: Theme.text-secondary;
        }
        c1 := ColourRamp {
            enabled <=> root.enabled;
            maximum: root.base_colours.length;
            ramp: @linear-gradient(90deg, base_colours[0], base_colours[1], base_colours[2], base_colours[3], base_colours[4], base_colours[5], base_colours[6], base_colours[7], base_colours[8], base_colours[9], base_colours[10], base_colours[11], base_colours[12], base_colours[13], base_colours[14], base_colours[15], base_colours[16], base_colours[17], base_colours[18], base_colours[19], base_colours[20], base_colours[21], base_colours[22], base_colours[23], base_colours[24], base_colours[25], base_colours[26], base_colours[27], base_colours[28], base_colours[29], base_colours[30], base_colours[31], base_colours[32], base_colours[33], base_colours[34], base_colours[35]);
            changed(value) => {
                set_base_colour();
                hex = set_hex_from_colour(final_colour);
            }
            released(value) => {
                root.released();
            }
        }
    }

    VerticalLayout {
        spacing: Spacing.xs;
        Text {
            text: @tr("Saturation");
            font-size: Typography.xs;
            color: Theme.text-secondary;
        }
        c2 := ColourRamp {
            enabled <=> root.enabled;
            maximum: root.base_saturation.length;
            ramp: @linear-gradient(90deg, base_saturation[0], base_saturation[1], base_saturation[2], base_saturation[3], base_saturation[4], base_saturation[5], base_saturation[6], base_saturation[7], base_saturation[8], base_saturation[9], base_saturation[10]);
            changed(value) => {
                set_base_colour();
                hex = set_hex_from_colour(final_colour);
            }
            released(value) => {
                root.released();
            }
        }
    }

    VerticalLayout {
        spacing: Spacing.xs;
        Text {
            text: @tr("Brightness");
            font-size: Typography.xs;
            color: Theme.text-secondary;
        }
        c3 := ColourRamp {
            enabled <=> root.enabled;
            maximum: root.base_value.length;
            ramp: @linear-gradient(90deg, base_value[0], base_value[1], base_value[2], base_value[3], base_value[4], base_value[5], base_value[6], base_value[7], base_value[8], base_value[9], base_value[10]);
            changed(value) => {
                set_base_colour();
                hex = set_hex_from_colour(final_colour);
            }
            released(value) => {
                root.released();
            }
        }
    }

    HorizontalLayout {
        spacing: Spacing.md;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Spacing.xs;
            Text {
                text: @tr("Hex colour");
                font-size: Typography.xs;
                color: Theme.text-secondary;
            }
            HexInput {
                enabled <=> root.enabled;
                text <=> root.hex;
                accepted(value) => {
                    base_colour = hex_to_colour(value);
                    root.colourbox = base_colour;
                    root.final_colour = base_colour;
                    root.external_colour_change();
                    root.released();
                }
            }
        }

        Rectangle {
            width: 36px;
            height: 36px;
            border-width: 1px;
            border-radius: Radii.md;
            border-color: Theme.border;
            background <=> root.colourbox;
        }
    }
}
