import { Palette, VerticalBox , StandardButton, Button, HorizontalBox, ComboBox, Switch, Slider} from "std-widgets.slint";
import { Spacing, Typography, Radii, Shadows, Animations, Theme } from "../globals.slint";

export component RogItem inherits Rectangle {
    min-width: 0px;
    horizontal-stretch: 1;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Radii.md;
    min-height: 52px;
    max-height: 60px;
    
    states [
        hover when hover_area.has-hover: {
            background: Theme.surface-hover;
            border-color: Theme.border-focus;
        }
    ]

    animate background, border-color {
        duration: Animations.fast;
        easing: Animations.ease;
    }
    
    hover_area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: false; // Just for hover detection if needed, but we use parent state
    }
}

export component PageHeader inherits Rectangle {
    in property <string> badge: "";
    in property <string> title;
    in property <string> subtitle;
    in property <string> aside: "";
    // Compact headers keep the page identity clear without pushing the
    // actual controls below a large block of prose. Set compact to false only
    // for pages that genuinely need a longer introduction.
    in property <bool> compact: true;
    height: root.compact ? 104px : 136px;
    border-radius: Radii.lg;
    border-width: 1px;
    border-color: Theme.border-focus.with-alpha(0.35);
    background: Theme.surface-gradient;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 5px;
        height: parent.height;
        background: @linear-gradient(180deg, Theme.primary 0%, Theme.primary.darker(30%) 100%);
    }

    if root.badge != "": Text {
        x: Spacing.lg;
        y: Spacing.md;
        width: parent.width - Spacing.xl;
        color: Theme.primary;
        font-size: Typography.xs;
        font-weight: Typography.weight-semibold;
        text: root.badge;
    }

    Text {
        x: Spacing.lg;
        y: badge != "" ? 34px : 22px;
        width: parent.width - Spacing.xl;
        color: Theme.text-primary;
        font-size: Typography.xl;
        font-weight: Typography.weight-bold;
        text: root.title;
        overflow: TextOverflow.elide;
    }

    Text {
        x: Spacing.lg;
        y: badge != "" ? 66px : 54px;
        width: parent.width - Spacing.xl;
        color: Theme.text-secondary;
        font-size: Typography.sm;
        wrap: TextWrap.word-wrap;
        text: root.subtitle;
    }

    if root.aside != "" && !root.compact: Text {
        x: Spacing.lg;
        y: 110px;
        width: parent.width - Spacing.xl;
        color: Theme.text-tertiary;
        font-size: Typography.xs;
        font-weight: Typography.weight-semibold;
        text: root.aside;
        overflow: TextOverflow.elide;
    }
}

// Shared page stack: every page gets the same inset and vertical rhythm.
// Individual cards can still control their own internal spacing.
export component PageLayout inherits VerticalLayout {
    padding: Spacing.lg;
    spacing: Spacing.lg;
    alignment: LayoutAlignment.start;
}

export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";

    horizontal-stretch: 1;
    min-width: 0px;
    min-height: subtitle == "" ? 40px : 56px;
    max-height: subtitle == "" ? 52px : 72px;
    background: transparent;
    border-width: 0px;

    VerticalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: Spacing.sm;
        padding-bottom: Spacing.sm;
        spacing: Spacing.xs;
        alignment: LayoutAlignment.center;

        Text {
            text: root.title;
            font-size: Typography.md;
            font-weight: Typography.weight-semibold;
            color: Theme.text-primary;
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: Typography.sm;
            color: Theme.text-secondary;
            wrap: TextWrap.word-wrap;
        }
    }
}

// Small themed action button used for page actions. The stock Fluent button
// becomes almost black when disabled, which makes its label hard to read on
// the dark ROG surface.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();

    min-width: 84px;
    min-height: 42px;
    max-height: 52px;
    border-radius: Radii.sm;
    border-width: 1px;
    border-color: !root.enabled
        ? Theme.border
        : (root.primary ? Theme.primary : Theme.border-focus.with-alpha(0.35));
    background: !root.enabled
        ? Theme.surface-active
        : (root.primary ? Theme.primary.with-alpha(0.14) : Theme.surface);

    states [
        hover when touch.has-hover && root.enabled: {
            background: root.primary ? Theme.primary.with-alpha(0.24) : Theme.surface-hover;
            border-color: Theme.primary;
        }
        pressed when touch.pressed && root.enabled: {
            background: root.primary ? Theme.primary.with-alpha(0.34) : Theme.surface-active;
        }
    ]

    animate background, border-color {
        duration: Animations.fast;
        easing: Animations.ease;
    }

    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: !root.enabled ? Theme.text-secondary : Theme.text-primary;
        font-size: Typography.xs;
        font-weight: root.primary ? Typography.weight-semibold : Typography.weight-medium;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Custom toggle that uses Theme.primary instead of the std-widgets palette
export component PrimarySwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: Radii.lg;
    background: enabled
        ? (checked ? Theme.primary.with-alpha(0.9) : Theme.surface-active)
        : Theme.surface;
    border-width: 1px;
    border-color: checked ? Theme.primary : Theme.border;

    animate background, border-color {
        duration: Animations.fast;
        easing: Animations.ease;
    }

    thumb := Rectangle {
        width: parent.height - 6px;
        height: parent.height - 6px;
        y: 3px;
        x: checked ? parent.width - self.width - 3px : 3px;
        border-radius: Radii.full;
        background: Theme.text-primary;
        drop-shadow-blur: Shadows.sm-blur;
        drop-shadow-color: Shadows.color;

        animate x {
            duration: Animations.fast;
            easing: Animations.ease;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Custom slider that uses Theme.primary instead of the std-widgets palette
export component PrimarySlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> enabled: true;
    callback changed(float);
    callback released(float);

    height: 24px;
    border-radius: Radii.lg;
    background: transparent;
    opacity: enabled ? 1.0 : 0.6;
    property <length> thumb-size: 18px;

    property <float> normalized: maximum > minimum ? (value - minimum) / (maximum - minimum) : 0.0;

    Rectangle {
        // track background
        x: root.thumb-size / 2;
        y: root.height / 2 - 3px;
        width: root.width - root.thumb-size;
        height: 6px;
        border-radius: Radii.lg;
        background: Theme.surface-hover;
    }

    Rectangle {
        // filled track
        x: root.thumb-size / 2;
        y: root.height / 2 - 3px;
        width: (root.width - root.thumb-size) * normalized;
        height: 6px;
        border-radius: Radii.lg;
        background: enabled ? Theme.primary : Theme.text-secondary;
    }

    thumb := Rectangle {
        width: root.thumb-size;
        height: root.thumb-size;
        x: root.thumb-size / 2 + (root.width - root.thumb-size) * normalized;
        y: root.height / 2 - self.height / 2;
        border-radius: Radii.full;
        background: Theme.surface;
        border-width: 2px;
        border-color: enabled ? Theme.primary : Theme.border;
        drop-shadow-blur: Shadows.sm-blur;
        drop-shadow-color: Shadows.color;

        animate border-color {
            duration: Animations.fast;
            easing: Animations.ease;
        }
    }

    TouchArea {
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        mouse-cursor: ew-resize;

        clicked => {
            root.update_from_pos(self.mouse-x);
            root.released(root.value);
        }

        moved => {
            if (self.pressed) {
                root.update_from_pos(self.mouse-x);
            }
        }
    }

    public function update_from_pos(x: length) {
        let span = maximum - minimum;
        let usable = root.width - root.thumb-size;
        if (span <= 0 || usable <= 0) {
            return;
        }
        let raw = (x - root.thumb-size / 2) / usable;
        let frac = Math.max(0.0, Math.min(1.0, raw));
        let new_val = minimum + frac * span;
        value = new_val;
        changed(new_val);
    }
}

export component SystemSlider inherits RogItem {
    in property <string> title;
    in property <string> text;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    callback released(float);

    in property <string> help_text;
    in property <bool> enabled: true;
    in property <bool> has_reset: false;
    callback cb_do_reset();

    property <bool> compact: self.width < 540px;
    min-height: compact ? 104px : 68px;
    max-height: compact ? 140px : 92px;

    if !compact: HorizontalLayout {
        width: 100%;
        min-width: 0px;
        padding: Spacing.md;
        spacing: Spacing.md;
        alignment: LayoutAlignment.stretch;

        HorizontalLayout {
            horizontal-stretch: 35;
            min-width: 140px;
            spacing: Spacing.sm;
            alignment: LayoutAlignment.stretch;

            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: Typography.md;
                font-weight: Typography.weight-medium;
                vertical-alignment: TextVerticalAlignment.center;
                color: root.enabled ? Theme.text-primary : Theme.text-secondary;
                text: root.text;
                wrap: TextWrap.word-wrap;
                overflow: TextOverflow.elide;
            }

            Text {
                horizontal-stretch: 0;
                min-width: 36px;
                font-size: Typography.md;
                font-weight: Typography.weight-bold;
                horizontal-alignment: TextHorizontalAlignment.right;
                vertical-alignment: TextVerticalAlignment.center;
                color: root.enabled ? Theme.primary : Theme.text-secondary;
                text: "\{Math.round(root.value)}";
            }
        }

        slider := PrimarySlider {
            horizontal-stretch: 65;
            min-width: 120px;
            enabled: root.enabled;
            maximum: root.maximum;
            minimum: root.minimum;
            value <=> root.value;
            released(value) => {
                root.released(value)
            }
        }

        HorizontalLayout {
            spacing: Spacing.md;
            horizontal-stretch: 0;
            min-width: 0px;
            alignment: LayoutAlignment.end;

            help_popup_wide := PopupWindow {
                x: help_anchor_wide.x - self.width + help_anchor_wide.width - Spacing.md;
                y: help_anchor_wide.y - self.height + help_anchor_wide.height - Spacing.md;
                Rectangle {
                    drop-shadow-blur: Shadows.lg-blur;
                    drop-shadow-color: Shadows.color;
                    drop-shadow-offset-y: 4px;
                    border-radius: Radii.lg;
                    border-color: Theme.border;
                    border-width: 1px;
                    background: Theme.surface;
                    Dialog {
                        title: root.title;
                        VerticalBox {
                            spacing: Spacing.md;
                            Text {
                                max-width: 420px;
                                font-size: Typography.lg;
                                font-weight: Typography.weight-semibold;
                                wrap: TextWrap.word-wrap;
                                horizontal-alignment: TextHorizontalAlignment.center;
                                text: root.title;
                                color: Theme.text-primary;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            Text {
                                max-width: 420px;
                                font-size: Typography.md;
                                wrap: TextWrap.word-wrap;
                                text: root.help_text;
                                color: Theme.text-secondary;
                            }
                        }

                        StandardButton {
                            kind: ok;
                        }
                    }
                }
            }

            reset_popup_wide := PopupWindow {
                x: reset_anchor_wide.x - self.width + reset_anchor_wide.width;
                y: reset_anchor_wide.y - self.height + reset_anchor_wide.height;
                Rectangle {
                    drop-shadow-blur: Shadows.lg-blur;
                    drop-shadow-color: Shadows.color;
                    drop-shadow-offset-y: 4px;
                    border-radius: Radii.lg;
                    border-color: Theme.border;
                    border-width: 1px;
                    background: Theme.surface;
                    Dialog {
                        Text {
                            max-width: 420px;
                            font-size: Typography.md;
                            font-weight: Typography.weight-medium;
                            wrap: TextWrap.word-wrap;
                            text: @tr("confirm_reset" => "Are you sure you want to reset this?");
                            color: Theme.text-primary;
                        }

                        StandardButton {
                            kind: ok;
                            clicked => {
                                root.cb_do_reset();
                            }
                        }

                        StandardButton {
                            kind: cancel;
                        }
                    }
                }
            }

            help_anchor_wide := Rectangle {
                width: help_text != "" ? 60px : 0px;
                if (help_text != ""): StandardButton {
                    kind: StandardButtonKind.help;
                    width: 100%;
                    height: 32px;
                    clicked => {
                        help_popup_wide.show();
                    }
                }
            }

            reset_anchor_wide := Rectangle {
                width: has_reset ? 60px : 0px;
                if (has_reset): ActionButton {
                    text: @tr("Reset");
                    enabled: root.enabled;
                    min-width: 60px;
                    min-height: 32px;
                    height: 32px;
                    width: 100%;
                    clicked => {
                        reset_popup_wide.show();
                    }
                }
            }
        }
    }

    if compact: VerticalLayout {
        width: 100%;
        min-width: 0px;
        padding: Spacing.md;
        spacing: Spacing.sm;

        HorizontalLayout {
            spacing: Spacing.sm;
            alignment: LayoutAlignment.space-between;

            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: Typography.md;
                font-weight: Typography.weight-medium;
                color: root.enabled ? Theme.text-primary : Theme.text-secondary;
                text: root.text;
                wrap: TextWrap.word-wrap;
            }

            Text {
                min-width: 36px;
                font-size: Typography.md;
                font-weight: Typography.weight-bold;
                horizontal-alignment: TextHorizontalAlignment.right;
                color: root.enabled ? Theme.primary : Theme.text-secondary;
                text: "\{Math.round(root.value)}";
            }
        }

        slider_compact := PrimarySlider {
            min-width: 120px;
            enabled: root.enabled;
            maximum: root.maximum;
            minimum: root.minimum;
            value <=> root.value;
            released(value) => {
                root.released(value)
            }
        }

        HorizontalLayout {
            spacing: Spacing.md;
            alignment: LayoutAlignment.end;

            help_popup_compact := PopupWindow {
                x: help_anchor_compact.x - self.width + help_anchor_compact.width - Spacing.md;
                y: help_anchor_compact.y - self.height + help_anchor_compact.height - Spacing.md;
                Rectangle {
                    drop-shadow-blur: Shadows.lg-blur;
                    drop-shadow-color: Shadows.color;
                    drop-shadow-offset-y: 4px;
                    border-radius: Radii.lg;
                    border-color: Theme.border;
                    border-width: 1px;
                    background: Theme.surface;
                    Dialog {
                        title: root.title;
                        VerticalBox {
                            spacing: Spacing.md;
                            Text {
                                max-width: 420px;
                                font-size: Typography.lg;
                                font-weight: Typography.weight-semibold;
                                wrap: TextWrap.word-wrap;
                                horizontal-alignment: TextHorizontalAlignment.center;
                                text: root.title;
                                color: Theme.text-primary;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            Text {
                                max-width: 420px;
                                font-size: Typography.md;
                                wrap: TextWrap.word-wrap;
                                text: root.help_text;
                                color: Theme.text-secondary;
                            }
                        }

                        StandardButton {
                            kind: ok;
                        }
                    }
                }
            }

            reset_popup_compact := PopupWindow {
                x: reset_anchor_compact.x - self.width + reset_anchor_compact.width;
                y: reset_anchor_compact.y - self.height + reset_anchor_compact.height;
                Rectangle {
                    drop-shadow-blur: Shadows.lg-blur;
                    drop-shadow-color: Shadows.color;
                    drop-shadow-offset-y: 4px;
                    border-radius: Radii.lg;
                    border-color: Theme.border;
                    border-width: 1px;
                    background: Theme.surface;
                    Dialog {
                        Text {
                            max-width: 420px;
                            font-size: Typography.md;
                            font-weight: Typography.weight-medium;
                            wrap: TextWrap.word-wrap;
                            text: @tr("confirm_reset" => "Are you sure you want to reset this?");
                            color: Theme.text-primary;
                        }

                        StandardButton {
                            kind: ok;
                            clicked => {
                                root.cb_do_reset();
                            }
                        }

                        StandardButton {
                            kind: cancel;
                        }
                    }
                }
            }

            help_anchor_compact := Rectangle {
                width: help_text != "" ? 60px : 0px;
                if (help_text != ""): StandardButton {
                    kind: StandardButtonKind.help;
                    width: 100%;
                    height: 32px;
                    clicked => {
                        help_popup_compact.show();
                    }
                }
            }

            reset_anchor_compact := Rectangle {
                width: has_reset ? 60px : 0px;
                if (has_reset): ActionButton {
                    text: @tr("Reset");
                    enabled: root.enabled;
                    min-width: 60px;
                    min-height: 32px;
                    height: 32px;
                    width: 100%;
                    clicked => {
                        reset_popup_compact.show();
                    }
                }
            }
        }
    }
}

export component SystemToggle inherits RogItem {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    property <bool> compact: self.width < 360px;
    min-height: compact ? 86px : 60px;
    max-height: compact ? 120px : 76px;

    if !compact: HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: LayoutAlignment.start;
            Text {
                min-width: 0px;
                font-size: Typography.md;
                font-weight: Typography.weight-medium;
                vertical-alignment: TextVerticalAlignment.center;
                color: Theme.text-primary;
                text: root.text;
                wrap: TextWrap.word-wrap;
                overflow: TextOverflow.elide;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: LayoutAlignment.end;
            PrimarySwitch {
                checked <=> root.checked;
                toggled => {
                    root.toggled(root.checked)
                }
            }
        }
    }

    if compact: VerticalLayout {
        padding: Spacing.md;
        spacing: Spacing.sm;

        Text {
            font-size: Typography.md;
            font-weight: Typography.weight-medium;
            color: Theme.text-primary;
            text: root.text;
            wrap: TextWrap.word-wrap;
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            PrimarySwitch {
                checked <=> root.checked;
                toggled => {
                    root.toggled(root.checked)
                }
            }
        }
    }
}

export component SystemToggleInt inherits RogItem {
    in property <string> text;
    in-out property <int> checked_int;
    callback toggled(int);
    property <bool> compact: self.width < 360px;
    min-height: compact ? 86px : 60px;
    max-height: compact ? 120px : 76px;

    if !compact: HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: LayoutAlignment.start;
            Text {
                min-width: 0px;
                font-size: Typography.md;
                font-weight: Typography.weight-medium;
                vertical-alignment: TextVerticalAlignment.center;
                color: Theme.text-primary;
                text: root.text;
                wrap: TextWrap.word-wrap;
                overflow: TextOverflow.elide;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: LayoutAlignment.end;
            PrimarySwitch {
                checked: root.checked_int != 0;
                toggled => {
                    root.checked_int = self.checked ? 1 : 0;
                    root.toggled(root.checked_int);
                }
            }
        }
    }

    if compact: VerticalLayout {
        padding: Spacing.md;
        spacing: Spacing.sm;

        Text {
            font-size: Typography.md;
            font-weight: Typography.weight-medium;
            color: Theme.text-primary;
            text: root.text;
            wrap: TextWrap.word-wrap;
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            PrimarySwitch {
                checked: root.checked_int != 0;
                toggled => {
                    root.checked_int = self.checked ? 1 : 0;
                    root.toggled(root.checked_int);
                }
            }
        }
    }
}

export component SystemToggleVert inherits RogItem {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    min-height: 90px;

    VerticalLayout {
        padding: Spacing.md;
        spacing: Spacing.sm;
        alignment: LayoutAlignment.space-around;

        Text {
            font-size: Typography.md;
            font-weight: Typography.weight-medium;
            vertical-alignment: TextVerticalAlignment.bottom;
            horizontal-alignment: TextHorizontalAlignment.center;
            color: Theme.text-primary;
            text: root.text;
        }

        HorizontalLayout {
            alignment: LayoutAlignment.center;
            PrimarySwitch {
                checked <=> root.checked;
                toggled => {
                    root.toggled(root.checked)
                }
            }
        }
    }
}

export component SystemDropdown inherits RogItem {
    in property <string> text;
    in-out property <int> current_index;
    in-out property <string> current_value;
    in-out property <[string]> model;
    in property <bool> enabled: true;
    callback selected(int);

    min-height: 60px;
    max-height: 80px;

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        HorizontalLayout {
            alignment: LayoutAlignment.start;
            Text {
                font-size: Typography.md;
                font-weight: Typography.weight-medium;
                vertical-alignment: TextVerticalAlignment.center;
                color: root.enabled ? Theme.text-primary : Theme.text-secondary;
                text: root.text;
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            ComboBox {
                enabled: root.enabled;
                model <=> root.model;
                current-index <=> root.current_index;
                current-value <=> root.current_value;
                selected => {
                    root.selected(root.current_index)
                }
            }
        }
    }
}

export component PopupNotification {
    in property <string> heading;
    in property <string> content;
    _p := PopupWindow {
        x: root.x;
        y: root.y;
        width: root.width;
        height: root.height;

        Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;
            border-radius: Radii.xl;
            drop-shadow-blur: Shadows.xl-blur;
            drop-shadow-color: Shadows.color;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                Dialog {
                    VerticalLayout {
                        alignment: start;
                        spacing: Spacing.lg;
                        padding: Spacing.md;

                        Text {
                            text: heading;
                            color: Theme.text-primary;
                            font-size: Typography.xxl;
                            font-weight: Typography.weight-bold;
                        }

                        Rectangle {
                            height: 2px;
                            background: Theme.border;
                        }

                        Text {
                            text: content;
                            color: Theme.text-secondary;
                            font-size: Typography.lg;
                            wrap: word-wrap;
                        }
                    }

                    StandardButton {
                        kind: ok;
                    }

                    StandardButton {
                        kind: cancel;
                    }

                    Button {
                        text: "More Info";
                        dialog-button-role: action;
                    }
                }
            }
        }
    }

    public function show() {
        _p.show();
    }
}
