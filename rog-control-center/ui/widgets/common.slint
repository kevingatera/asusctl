import { Palette, VerticalBox , StandardButton, Button, HorizontalBox, ComboBox, Switch, Slider} from "std-widgets.slint";
import { Spacing, Typography, Radii, Shadows, Animations } from "../globals.slint";

export component RogItem inherits Rectangle {
    background: Palette.control-background;
    border-color: Palette.border.with-alpha(60);
    border-width: 1px;
    border-radius: Radii.md;
    min-height: 52px;
    max-height: 60px;
    drop-shadow-blur: Shadows.sm-blur;
    drop-shadow-color: Colors.black.with-alpha(0.08);
    drop-shadow-offset-y: 2px;
}

export component SystemSlider inherits RogItem {
    in property <string> title;
    in property <string> text;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    callback released(float);

    in property <string> help_text;
    in property <bool> enabled: true;
    in property <bool> has_reset: false;
    callback cb_do_reset();

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        HorizontalLayout {
            width: 40%;
            alignment: LayoutAlignment.stretch;
            HorizontalLayout {
                spacing: Spacing.sm;
                Text {
                    font-size: Typography.md;
                    font-weight: Typography.weight-medium;
                    vertical-alignment: TextVerticalAlignment.center;
                    color: Palette.control-foreground;
                    text: root.text;
                }

                Text {
                    font-size: Typography.md;
                    font-weight: Typography.weight-semibold;
                    horizontal-alignment: TextHorizontalAlignment.right;
                    vertical-alignment: TextVerticalAlignment.center;
                    color: Palette.accent-background;
                    text: "\{Math.round(root.value)}";
                }
            }
        }

        HorizontalBox {
            slider := Slider {
                enabled: root.enabled;
                maximum: root.maximum;
                minimum: root.minimum;
                value <=> root.value;
                released(value) => {
                    root.released(value)
                }
            }
        }

        help_popup := PopupWindow {
            x: help.x - self.width + help.width - Spacing.md;
            y: help.y - self.height + help.height - Spacing.md;
            Rectangle {
                drop-shadow-blur: Shadows.lg-blur;
                drop-shadow-color: Colors.black.with-alpha(0.4);
                drop-shadow-offset-y: 4px;
                border-radius: Radii.lg;
                border-color: Palette.accent-background.with-alpha(0.3);
                border-width: 1px;
                background: Palette.background;
                Dialog {
                    title: root.title;
                    VerticalBox {
                        spacing: Spacing.md;
                        Text {
                            max-width: 420px;
                            font-size: Typography.lg;
                            font-weight: Typography.weight-semibold;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            text: root.title;
                            color: Palette.foreground;
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.border.with-alpha(60);
                        }

                        Text {
                            max-width: 420px;
                            font-size: Typography.md;
                            wrap: TextWrap.word-wrap;
                            text: root.help_text;
                            color: Palette.foreground;
                        }
                    }

                    StandardButton {
                        kind: ok;
                    }
                }
            }
        }

        help := HorizontalBox {
            if (help_text != ""): StandardButton {
                kind: StandardButtonKind.help;
                clicked => {
                    help_popup.show();
                }
            }
        }

        reset_popup := PopupWindow {
            x: reset.x - self.width + reset.width;
            y: reset.y - self.height + reset.height;
            Rectangle {
                drop-shadow-blur: Shadows.lg-blur;
                drop-shadow-color: Colors.black.with-alpha(0.4);
                drop-shadow-offset-y: 4px;
                border-radius: Radii.lg;
                border-color: Palette.accent-background.with-alpha(0.3);
                border-width: 1px;
                background: Palette.background;
                Dialog {
                    Text {
                        max-width: 420px;
                        font-size: Typography.md;
                        font-weight: Typography.weight-medium;
                        wrap: TextWrap.word-wrap;
                        text: @tr("confirm_reset" => "Are you sure you want to reset this?");
                        color: Palette.foreground;
                    }

                    StandardButton {
                        kind: ok;
                        clicked => {
                            root.cb_do_reset();
                        }
                    }

                    StandardButton {
                        kind: cancel;
                    }
                }
            }
        }

        reset := HorizontalBox {
            if (has_reset): StandardButton {
                kind: StandardButtonKind.reset;
                enabled: root.enabled;
                clicked => {
                    reset_popup.show();
                }
            }
        }
    }
}

export component SystemToggle inherits RogItem {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);

    background: toggle_area.has-hover ? Palette.control-background.darker(0.02) : Palette.control-background;

    animate background {
        duration: Animations.fast;
        easing: ease-in-out;
    }

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        HorizontalLayout {
            alignment: LayoutAlignment.start;
            Text {
                font-size: Typography.md;
                font-weight: Typography.weight-medium;
                vertical-alignment: TextVerticalAlignment.center;
                color: Palette.control-foreground;
                text: root.text;
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            Switch {
                checked <=> root.checked;
                toggled => {
                    root.toggled(root.checked)
                }
            }
        }
    }

    toggle_area := TouchArea {
        width: 100%;
        height: 100%;
    }
}

export component SystemToggleInt inherits RogItem {
    in property <string> text;
    in-out property <int> checked_int;
    callback toggled(int);

    background: toggle_area.has-hover ? Palette.control-background.darker(0.02) : Palette.control-background;

    animate background {
        duration: Animations.fast;
        easing: ease-in-out;
    }

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        HorizontalLayout {
            alignment: LayoutAlignment.start;
            Text {
                font-size: Typography.md;
                font-weight: Typography.weight-medium;
                vertical-alignment: TextVerticalAlignment.center;
                color: Palette.control-foreground;
                text: root.text;
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            Switch {
                checked: root.checked_int != 0;
                toggled => {
                    root.checked_int = self.checked ? 1 : 0;
                    root.toggled(root.checked_int);
                }
            }
        }
    }

    toggle_area := TouchArea {
        width: 100%;
        height: 100%;
    }
}

export component SystemToggleVert inherits RogItem {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    min-height: 90px;

    background: toggle_area.has-hover ? Palette.control-background.darker(0.02) : Palette.control-background;

    animate background {
        duration: Animations.fast;
        easing: ease-in-out;
    }

    VerticalLayout {
        padding: Spacing.md;
        spacing: Spacing.sm;
        alignment: LayoutAlignment.space-around;

        Text {
            font-size: Typography.md;
            font-weight: Typography.weight-medium;
            vertical-alignment: TextVerticalAlignment.bottom;
            horizontal-alignment: TextHorizontalAlignment.center;
            color: Palette.control-foreground;
            text: root.text;
        }

        HorizontalLayout {
            alignment: LayoutAlignment.center;
            Switch {
                checked <=> root.checked;
                toggled => {
                    root.toggled(root.checked)
                }
            }
        }
    }

    toggle_area := TouchArea {
        width: 100%;
        height: 100%;
    }
}

export component SystemDropdown inherits RogItem {
    in property <string> text;
    in-out property <int> current_index;
    in-out property <string> current_value;
    in-out property <[string]> model;
    in property <bool> enabled: true;
    callback selected(int);

    background: dropdown_area.has-hover && root.enabled ? Palette.control-background.darker(0.02) : Palette.control-background;

    animate background {
        duration: Animations.fast;
        easing: ease-in-out;
    }

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        HorizontalLayout {
            alignment: LayoutAlignment.start;
            Text {
                font-size: Typography.md;
                font-weight: Typography.weight-medium;
                vertical-alignment: TextVerticalAlignment.center;
                color: root.enabled ? Palette.control-foreground : Palette.foreground.with-alpha(150);
                text: root.text;
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            ComboBox {
                enabled: root.enabled;
                model <=> root.model;
                current-index <=> root.current_index;
                current-value <=> root.current_value;
                selected => {
                    root.selected(root.current_index)
                }
            }
        }
    }

    dropdown_area := TouchArea {
        width: 100%;
        height: 100%;
    }
}

export component PopupNotification {
    in property <string> heading;
    in property <string> content;
    _p := PopupWindow {
        x: root.x;
        y: root.y;
        width: root.width;
        height: root.height;

        Rectangle {
            border-width: 1px;
            border-color: Palette.accent-background.with-alpha(0.3);
            background: Palette.background;
            border-radius: Radii.xl;
            drop-shadow-blur: Shadows.xl-blur;
            drop-shadow-color: Colors.black.with-alpha(0.5);
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                Dialog {
                    VerticalLayout {
                        alignment: start;
                        spacing: Spacing.lg;
                        padding: Spacing.md;

                        Text {
                            text: heading;
                            color: Palette.foreground;
                            font-size: Typography.xxxl;
                            font-weight: Typography.weight-bold;
                        }

                        Rectangle {
                            height: 2px;
                            background: Palette.accent-background.with-alpha(0.3);
                        }

                        Text {
                            text: content;
                            color: Palette.foreground;
                            font-size: Typography.lg;
                            wrap: word-wrap;
                        }
                    }

                    StandardButton {
                        kind: ok;
                    }

                    StandardButton {
                        kind: cancel;
                    }

                    Button {
                        text: "More Info";
                        dialog-button-role: action;
                    }
                }
            }
        }
    }

    public function show() {
        _p.show();
    }
}
