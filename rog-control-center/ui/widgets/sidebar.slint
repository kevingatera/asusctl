import { Palette, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Spacing, Typography, Radii, Shadows, Animations, Theme } from "../globals.slint";

component SideBarItem inherits Rectangle {
    in property <bool> selected;
    in property <bool> has-focus;
    in-out property <string> text <=> label.text;
    callback clicked <=> touch.clicked;
    min-height: self.visible ? 50px : 0px;
    border-radius: Radii.md;

    states [
        pressed when touch.pressed: {
            state.opacity: 0.95;
            state.background: Theme.surface-active;
        }
        hover when touch.has-hover: {
            state.opacity: 0.8;
            state.background: Theme.surface-hover;
        }
        selected when root.selected: {
            state.opacity: 1;
            state.background: Theme.primary.with-alpha(0.1);
            state.border-color: Theme.primary;
            state.border-width: 1px;
        }
        focused when root.has-focus: {
            state.opacity: 0.9;
            state.background: Theme.surface-hover;
        }
    ]

    state := Rectangle {
        opacity: 0;
        border-width: 0px;
        border-radius: Radii.md;
        border-color: transparent;
        background: transparent;

        animate opacity, background, border-color { duration: Animations.fast; easing: Animations.ease; }
    }

    l := HorizontalBox {
        padding: Spacing.md;
        spacing: Spacing.sm;
        label := Text {
            color: root.selected ? Theme.primary : Theme.text-secondary;
            vertical-alignment: center;
            font-size: Typography.base;
            font-weight: root.selected ? Typography.weight-bold : Typography.weight-medium;

            animate color { duration: Animations.fast; easing: Animations.ease; }
            animate font-weight { duration: Animations.fast; easing: Animations.ease; }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
    }
}

export component SideBar inherits Rectangle {
    in property <[string]> model: [];
    in property <[bool]> available: [];
    in property <string> title <=> label.text;
    out property <int> current-item: 0;
    out property <int> current-focused: fs.has-focus ? fs.focused-tab : -1;

    forward-focus: fs;
    accessible-role: tab;
    accessible-delegate-focus: root.current-focused >= 0 ? root.current-focused : root.current-item;
    background: transparent;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == "\n") {
                root.current-item = root.current-focused;
                return accept;
            }
            if (event.text == Key.UpArrow) {
                self.focused-tab = Math.max(self.focused-tab - 1,  0);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                self.focused-tab = Math.min(self.focused-tab + 1, root.model.length - 1);
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == " ") {
                root.current-item = root.current-focused;
                return accept;
            }
            return reject;
        }
        property <int> focused-tab: 0;
        x: 0;
        width: 0;
    }

    VerticalLayout {
        spacing: Spacing.lg;
        alignment: start;

        // Sidebar title with modern styling
        label := Text {
            font-size: Typography.xl;
            font-weight: Typography.weight-bold;
            horizontal-alignment: center;
            color: Theme.primary;
        }

        // Navigation items with spacing
        navigation := VerticalLayout {
            spacing: Spacing.xs;
            alignment: start;
            vertical-stretch: 0;
            for item[index] in root.model: SideBarItem {
                visible: root.available[index];
                clicked => {
                    root.current-item = index;
                }
                has-focus: index == root.current-focused;
                text: item;
                selected: index == root.current-item;
            }
        }

        VerticalLayout {
            bottom := VerticalBox {
                @children
            }
        }
    }
}
