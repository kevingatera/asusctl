import { Palette, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, Spacing, Radii, Typography, Shadows, Animations } from "../globals.slint";

export component Modal inherits Rectangle {
    in property <string> title;
    in-out property <bool> open: false;
    callback close();
    
    visible: open;
    width: 100%;
    height: 100%;
    x: 0;
    y: 0;
    z: 1000;

    // Backdrop
    Rectangle {
        background: Theme.background.with-alpha(0.8);
        opacity: 0.0;
        animate opacity { duration: Animations.fast; easing: Animations.ease; }
        
        states [
            opened when root.open: {
                opacity: 1.0;
            }
        ]
        
        TouchArea {
            clicked => {
                root.close();
            }
        }
    }

    // Content Container
    content := Rectangle {
        width: Math.min(600px, parent.width - Spacing.xxl * 2);
        height: Math.min(500px, parent.height - Spacing.xxl * 2);
        background: Theme.surface;
        border-radius: Radii.lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: Shadows.xl-blur;
        drop-shadow-color: Shadows.color;
        drop-shadow-offset-y: 8px;
        
        y: parent.height / 2 - self.height / 2 + 20px;
        opacity: 0.0;
        
        animate y, opacity { duration: Animations.normal; easing: Animations.ease; }

        states [
            opened when root.open: {
                y: parent.height / 2 - self.height / 2;
                opacity: 1.0;
            }
        ]

        VerticalLayout {
            padding: 0;
            
            // Header
            Rectangle {
                height: 60px;
                
                Rectangle {
                    width: 100%;
                    height: 1px;
                    y: parent.height - 1px;
                    background: Theme.border;
                }
                
                HorizontalLayout {
                    padding-left: Spacing.xl;
                    padding-right: Spacing.md;
                    alignment: space-between;
                    
                    Text {
                        text: root.title;
                        font-size: Typography.lg;
                        font-weight: Typography.weight-bold;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }

                    close_btn := Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: Radii.sm;
                        background: hover.has-hover ? Theme.surface-hover : transparent;
                        y: parent.height / 2 - self.height / 2;
                        
                        animate background { duration: Animations.fast; }

                        Text {
                            text: "✕";
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            font-size: Typography.lg;
                        }

                        hover := TouchArea {
                            clicked => {
                                root.close();
                            }
                        }
                    }
                }
            }

            // Content
            Rectangle {
                clip: true;
                VerticalBox {
                    padding: Spacing.xl;
                    spacing: Spacing.md;
                    @children
                }
            }
        }
    }
}
