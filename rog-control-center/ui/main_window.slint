import { Palette, Button, VerticalBox } from "std-widgets.slint";
import { AppSize, Spacing, Typography, Radii, Shadows, Animations } from "globals.slint";
import { PageSystem, SystemPageData, AttrMinMax } from "pages/system.slint";
import { SideBar } from "widgets/sidebar.slint";
import { PageAbout } from "pages/about.slint";
import { PageFans } from "pages/fans.slint";
import { PageAnime, AnimePageData } from "pages/anime.slint";
import { RogItem } from "widgets/common.slint";
import { PageAura } from "pages/aura.slint";
import { PageSlash, SlashPageData } from "pages/slash.slint";
import { Node } from "widgets/graph.slint";
export { Node }
import { FanPageData, FanType, Profile } from "types/fan_types.slint";
export { FanPageData, FanType, Profile }
import { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect } from "types/aura_types.slint";
export { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect }
import { PageAppSettings, AppSettingsPageData } from "pages/app_settings.slint";
import { PageSupergfx, SupergfxPageData } from "pages/supergfx.slint";

export { AppSize, AttrMinMax, SystemPageData, AnimePageData, AppSettingsPageData, SupergfxPageData, SlashPageData }

export global BottomBarData {
    in-out property <[string]> entries: [];
}

export component MainWindow inherits Window {
    title: "ROG Control Center";
    always-on-top: true;
    default-font-family: "Noto Sans";
    default-font-size: Typography.base;
    default-font-weight: Typography.weight-regular;
    icon: @image-url("../data/rog-control-center.png");

    // Responsive window sizing
    preferred-width: AppSize.width;
    preferred-height: AppSize.height;
    min-height: AppSize.min-height;
    min-width: AppSize.min-width;

    in property <[bool]> sidebar_items_avilable: [true, true, true, true, true, true, true, true];
    private property <bool> show_notif;
    private property <bool> fade_cover;
    private property <bool> toast: false;
    private property <string> toast_text: "I show when something is waiting";
    private property <bool> sidebar_collapsed: false;

    callback show_toast(string);
    show_toast(text) => {
        toast = text != "";
        toast_text = text;
    }
    callback exit-app();
    callback show_notification(bool);
    show_notification(yes) => {
        show_notif = yes;
        fade_cover = yes;
    }
    callback external_colour_change();
    external_colour_change() => {
        aura.external_colour_change();
        aura.external_colour_change();
    }

    // Beautiful gradient background
    background: @linear-gradient(180deg, Palette.background.darker(0.3) 0%, Palette.background.darker(0.15) 100%);
    VerticalLayout {
        spacing: 0px;
        padding: Spacing.md;
        HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            spacing: Spacing.lg;

            // Sidebar container with shadow and resizable handle
            sidebar_container := Rectangle {
                width: Math.max(180px, Math.min(400px, AppSize.sidebar-width));
                background: Palette.background.darker(0.08);
                border-radius: Radii.lg;
                drop-shadow-blur: Shadows.lg-blur;
                drop-shadow-color: Colors.black.with-alpha(0.3);
                drop-shadow-offset-y: 4px;

                // Resize handle on the right edge
                resize_handle := Rectangle {
                    x: parent.width - 4px;
                    width: 8px;
                    height: parent.height;
                    background: resize_area.has-hover ? Palette.accent-background.with-alpha(0.3) : transparent;
                    border-radius: 4px;

                    animate background {
                        duration: Animations.fast;
                        easing: ease-in-out;
                    }

                    resize_area := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: ew-resize;

                        moved => {
                            if (self.pressed) {
                                AppSize.sidebar-width = Math.max(180px, Math.min(400px, self.mouse-x + sidebar_container.x));
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Spacing.md;
                    padding: Spacing.md;
                    side-bar := SideBar {
                    title: @tr("ROG");
                    model: [
                        @tr("Menu1" => "System Control"),
                        @tr("Menu2" => "Keyboard Aura"),
                        @tr("Menu3" => "AniMe Matrix"),
                        @tr("Menu4" => "Slash Control"),
                        @tr("Menu5" => "Fan Curves"),
                        @tr("Menu6" => "Supergfx Control"),
                        @tr("Menu7" => "App Settings"),
                        @tr("Menu8" => "About"),
                    ];
                        available: root.sidebar_items_avilable;
                        vertical-stretch: 1;
                    }

                    // Status panel with improved styling
                    status_panel := Rectangle {
                        visible: BottomBarData.entries.length > 0;
                        border-radius: Radii.lg;
                        border-width: 1px;
                        border-color: Palette.border.with-alpha(80);
                        background: Palette.accent-background.with-alpha(0.1);
                        drop-shadow-blur: Shadows.sm-blur;
                        drop-shadow-color: Colors.black.with-alpha(0.2);

                        entries_layout := VerticalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.sm;
                            for entry[index] in BottomBarData.entries: Text {
                                color: Palette.control-foreground;
                                font-size: Typography.sm;
                                font-weight: Typography.weight-medium;
                                text: entry;
                            }
                        }
                    }

                    // Quit button with hover effect
                    quit_button := Rectangle {
                        max-height: 44px;
                        background: quit_area.has-hover ? Palette.accent-background.darker(0.1) : Palette.accent-background;
                        border-radius: Radii.md;
                        drop-shadow-blur: quit_area.pressed ? Shadows.sm-blur : Shadows.md-blur;
                        drop-shadow-color: Colors.black.with-alpha(0.3);
                        drop-shadow-offset-y: quit_area.pressed ? 1px : 2px;

                        animate background, drop-shadow-blur, drop-shadow-offset-y {
                            duration: Animations.fast;
                            easing: ease-in-out;
                        }

                        Text {
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: @tr("Quit App");
                            font-size: Typography.md;
                            font-weight: Typography.weight-semibold;
                            color: Colors.white;
                        }

                        quit_area := TouchArea {
                            clicked => {
                                root.exit-app();
                            }
                        }
                    }
                }
            }

            // Main content area with card styling
            content_card := Rectangle {
                horizontal-stretch: 1;
                background: Palette.background;
                border-radius: Radii.lg;
                drop-shadow-blur: Shadows.xl-blur;
                drop-shadow-color: Colors.black.with-alpha(0.25);
                drop-shadow-offset-y: 6px;

                // Content pages
                if(side-bar.current-item == 0): page := PageSystem {
                    width: parent.width;
                    height: parent.height;
                }

                aura := PageAura {
                    width: parent.width;
                    height: parent.height;
                    visible: side-bar.current-item == 1;
                }

                if(side-bar.current-item == 2): PageAnime {
                    width: parent.width;
                    height: parent.height;
                }

                slash := PageSlash {
                    width: parent.width;
                    height: parent.height;
                    visible: side-bar.current-item == 3;
                }

                fans := PageFans {
                    width: parent.width;
                    height: parent.height;
                    visible: side-bar.current-item == 4;
                }

                if(side-bar.current-item == 5): PageSupergfx {
                    width: parent.width;
                    height: parent.height;
                }

                if(side-bar.current-item == 6): PageAppSettings {
                    width: parent.width;
                    height: parent.height;
                }

                if(side-bar.current-item == 7): PageAbout {
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }

    // Modern backdrop blur effect
    if fade_cover: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Colors.black.with-alpha(0.5);
        opacity: fade_cover ? 1.0 : 0.0;

        animate opacity {
            duration: Animations.normal;
            easing: ease-in-out;
        }

        TouchArea {
            height: 100%;
            width: 100%;
            clicked => {
                if (show_notif) {
                    show_notif = false;
                }
                fade_cover = false;
            }
        }
    }

    // Beautiful toast notification
    if toast: Rectangle {
        x: Spacing.xl;
        y: Spacing.xl;
        width: root.width - (Spacing.xl * 2);
        height: 48px;

        Rectangle {
            height: 100%;
            width: 100%;
            background: @linear-gradient(90deg, Palette.accent-background 0%, Palette.accent-background.darker(0.2) 100%);
            border-radius: Radii.md;
            drop-shadow-blur: Shadows.lg-blur;
            drop-shadow-color: Colors.black.with-alpha(0.4);
            drop-shadow-offset-y: 4px;

            HorizontalLayout {
                padding: Spacing.md;
                spacing: Spacing.md;
                alignment: LayoutAlignment.start;

                Text {
                    color: Colors.white;
                    text: root.toast_text;
                    font-size: Typography.md;
                    font-weight: Typography.weight-medium;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                height: 100%;
                width: 100%;
                clicked => {
                    toast = false;
                }
            }
        }
    }

    // Modern notification modal
    if show_notif: Rectangle {
        x: root.width / 8;
        y: root.height / 8;
        height: (root.height / 8) * 6;
        width: (root.width / 8) * 6;

        Rectangle {
            height: 100%;
            width: 100%;
            background: Palette.background;
            border-radius: Radii.xl;
            drop-shadow-blur: Shadows.xl-blur;
            drop-shadow-color: Colors.black.with-alpha(0.5);
            border-width: 1px;
            border-color: Palette.accent-background.with-alpha(0.3);

            VerticalLayout {
                padding: Spacing.xxl;
                spacing: Spacing.xl;
                alignment: LayoutAlignment.center;

                Text {
                    text: "Click here to exit";
                    font-size: Typography.xxl;
                    font-weight: Typography.weight-bold;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
            }

            TouchArea {
                height: 100%;
                width: 100%;
                clicked => {
                    show_notif = false;
                    exit-app();
                }
            }
        }
    }

    // Beautiful error display
    if SomeError.error_message != "": Rectangle {
        x: Spacing.xxl;
        y: Spacing.xxl;
        width: root.width - (Spacing.xxl * 2);
        height: root.height - (Spacing.xxl * 2);

        Rectangle {
            background: Palette.background;
            border-radius: Radii.xl;
            drop-shadow-blur: Shadows.xl-blur;
            drop-shadow-color: Colors.black.with-alpha(0.6);
            border-width: 2px;
            border-color: Colors.red.with-alpha(0.5);

            VerticalLayout {
                padding: Spacing.xxl;
                spacing: Spacing.xl;

                Rectangle {
                    background: Colors.red.with-alpha(0.1);
                    border-radius: Radii.md;
                    min-height: 60px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        Text {
                            text <=> SomeError.error_message;
                            font-size: Typography.xl;
                            font-weight: Typography.weight-bold;
                            color: Colors.red;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                Text {
                    text <=> SomeError.error_help;
                    font-size: Typography.md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
            }
        }
    }
}

export global SomeError {
    in property <string> error_message: "";
    in property <string> error_help: "";
}
