import { Palette, Button, VerticalBox } from "std-widgets.slint";
import { AppSize, Spacing, Typography, Radii, Shadows, Animations, Theme } from "globals.slint";
import { PageSystem, SystemPageData, AttrMinMax } from "pages/system.slint";
import { SideBar } from "widgets/sidebar.slint";
import { PageAbout } from "pages/about.slint";
import { PageFans } from "pages/fans.slint";
import { PageAnime, AnimePageData } from "pages/anime.slint";
import { RogItem } from "widgets/common.slint";
import { PageAura } from "pages/aura.slint";
import { PageSlash, SlashPageData } from "pages/slash.slint";
import { Node } from "widgets/graph.slint";
import { Modal } from "widgets/modal.slint";
import { ColourSlider } from "widgets/colour_picker.slint";
export { Node }
import { FanPageData, FanType, Profile } from "types/fan_types.slint";
export { FanPageData, FanType, Profile }
import { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect } from "types/aura_types.slint";
export { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect }
import { PageAppSettings, AppSettingsPageData } from "pages/app_settings.slint";
import { PageSupergfx, SupergfxPageData } from "pages/supergfx.slint";

export { AppSize, AttrMinMax, SystemPageData, AnimePageData, AppSettingsPageData, SupergfxPageData, SlashPageData, Theme }

export global BottomBarData {
    in-out property <[string]> entries: [];
}

export component MainWindow inherits Window {
    title: "ROG Control Center";
    always-on-top: false;
    default-font-family: "Noto Sans";
    default-font-size: Typography.base;
    default-font-weight: Typography.weight-regular;
    icon: @image-url("../data/rog-control-center.png");

    preferred-width: AppSize.width;
    preferred-height: AppSize.height;
    min-height: AppSize.min-height;
    min-width: AppSize.min-width;

    in property <[bool]> sidebar_items_avilable: [true, true, true, true, true, true, true, true];
    private property <bool> toast: false;
    private property <string> toast_text: "I show when something is waiting";
    toast_timer := Timer {
        interval: AppSettingsPageData.toast_timeout_seconds * 1000ms;
        running: false;
        triggered => {
            toast = false;
            toast_timer.running = false;
        }
    }

    callback show_toast(string);
    show_toast(text) => {
        toast = text != "";
        toast_text = text;
        if (toast && AppSettingsPageData.toast_timeout_seconds > 0) {
            toast_timer.start();
        } else {
            toast_timer.stop();
        }
    }
    callback clear_toast_if_matches(string);
    clear_toast_if_matches(text) => {
        if (toast && toast_text == text) {
            toast = false;
            toast_text = "";
        }
    }
    callback exit-app();
    callback external_colour_change();
    external_colour_change() => {
        aura.external_colour_change();
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;
        
        HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            spacing: 0px;

            sidebar_container := Rectangle {
                width: Math.max(240px, Math.min(520px, AppSize.sidebar-width));
                background: Theme.surface;
                
                Rectangle {
                    width: 1px;
                    height: 100%;
                    x: parent.width - 1px;
                    background: Theme.border;
                }

                resize_handle := Rectangle {
                    x: parent.width - 4px;
                    width: 8px;
                    height: parent.height;
                    background: resize_area.has-hover ? Theme.primary.with-alpha(0.5) : transparent;
                    z: 100;

                    animate background {
                        duration: Animations.fast;
                        easing: Animations.ease;
                    }

                    resize_area := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: ew-resize;

                        moved => {
                            if (self.pressed) {
                                AppSize.sidebar-width = Math.max(200px, Math.min(400px, AppSize.sidebar-width + self.mouse-x - self.pressed-x));
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Spacing.lg;
                    padding: Spacing.lg;
                    
                    side-bar := SideBar {
                        title: @tr("ROG");
                        model: [
                            @tr("Menu1" => "System Control"),
                            @tr("Menu2" => "Keyboard Aura"),
                            @tr("Menu3" => "AniMe Matrix"),
                            @tr("Menu4" => "Slash Control"),
                            @tr("Menu5" => "Fan Curves"),
                            @tr("Menu6" => "Supergfx Control"),
                            @tr("Menu7" => "App Settings"),
                            @tr("Menu8" => "About"),
                        ];
                        available: root.sidebar_items_avilable;
                        vertical-stretch: 1;
                    }

                    status_panel := Rectangle {
                        visible: BottomBarData.entries.length > 0;
                        border-radius: Radii.md;
                        background: Theme.surface-active;
                        border-width: 1px;
                        border-color: Theme.border;

                        entries_layout := VerticalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.xs;
                            for entry[index] in BottomBarData.entries: Text {
                                color: Theme.text-primary;
                                font-size: Typography.sm;
                                font-weight: Typography.weight-semibold;
                                text: entry;
                            }
                        }
                    }

                    quit_button := Rectangle {
                        min-height: 40px;
                        preferred-height: 40px;
                        max-height: 40px;
                        horizontal-stretch: 1;
                        background: quit_area.has-hover ? Theme.surface-hover : transparent;
                        border-radius: Radii.md;
                        border-width: 1px;
                        border-color: quit_area.has-hover ? Theme.border : transparent;

                        animate background, border-color {
                            duration: Animations.fast;
                            easing: Animations.ease;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: Spacing.sm;
                            Text {
                                vertical-alignment: center;
                                text: @tr("Quit App");
                                font-size: Typography.sm;
                                font-weight: Typography.weight-medium;
                                color: quit_area.has-hover ? Theme.text-primary : Theme.text-secondary;
                            }
                        }

                        quit_area := TouchArea {
                            clicked => {
                                root.exit-app();
                            }
                        }
                    }
                }
            }

            content_card := Rectangle {
                horizontal-stretch: 1;
                background: Theme.background;
                clip: true;

                if(side-bar.current-item == 0): page := PageSystem {
                    width: parent.width;
                    height: parent.height;
                }

                aura := PageAura {
                    width: parent.width;
                    height: parent.height;
                    visible: side-bar.current-item == 1;
                }

                if(side-bar.current-item == 2): PageAnime {
                    width: parent.width;
                    height: parent.height;
                }

                slash := PageSlash {
                    width: parent.width;
                    height: parent.height;
                    visible: side-bar.current-item == 3;
                }

                fans := PageFans {
                    width: parent.width;
                    height: parent.height;
                    visible: side-bar.current-item == 4;
                }

                if(side-bar.current-item == 5): PageSupergfx {
                    width: parent.width;
                    height: parent.height;
                }

                if(side-bar.current-item == 6): PageAppSettings {
                    width: parent.width;
                    height: parent.height;
                }

                if(side-bar.current-item == 7): PageAbout {
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }

    // Streamlined Toast Notification
    if toast: Rectangle {
        x: root.width / 2 - self.width / 2;
        y: root.height - self.height - Spacing.xxl;
        width: Math.min(400px, root.width - Spacing.xl * 2);
        height: 48px;
        z: 1000;

        Rectangle {
            height: 100%;
            width: 100%;
            background: Theme.surface;
            border-radius: Radii.lg;
            border-width: 1px;
            border-color: Theme.primary.with-alpha(0.5);
            drop-shadow-blur: Shadows.lg-blur;
            drop-shadow-color: Shadows.color;
            drop-shadow-offset-y: 4px;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                spacing: Spacing.md;
                alignment: LayoutAlignment.center;

                Text {
                    color: Theme.text-primary;
                    text: root.toast_text;
                    font-size: Typography.md;
                    font-weight: Typography.weight-medium;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                height: 100%;
                width: 100%;
                clicked => {
                    toast = false;
                }
            }
        }
    }

    // Accent Color Picker Modal
    Modal {
        title: "Pick Accent Color";
        open: AppSettingsPageData.show_color_picker;
        close => {
            AppSettingsPageData.show_color_picker = false;
        }
        
        VerticalBox {
            alignment: center;
            spacing: Spacing.lg;
            
            ColourSlider {
                enabled: true;
                final_colour: Theme.primary;
                colourbox: Theme.primary;
                released => {
                    Theme.primary = self.final_colour;
                    AppSettingsPageData.set_accent_color(self.final_colour);
                }
                hex_to_colour(s) => {
                    return AppSettingsPageData.cb_hex_to_colour(s);
                }
                set_hex_from_colour(c) => {
                    return AppSettingsPageData.cb_hex_from_colour(c);
                }
            }
            
            Button {
                text: "Done";
                clicked => {
                    AppSettingsPageData.show_color_picker = false;
                }
            }
        }
    }
}
